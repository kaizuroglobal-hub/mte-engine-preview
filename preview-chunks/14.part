function fetchYahooHistory(symbol){
 const key=String(symbol);
 const rows=EMBEDDED_HISTORY[key];
 if(!rows || rows.length<100) throw new Error("Historical cache unavailable for "+symbol+". This preview contains the committed MTE historical cache only.");
 return Promise.resolve(rows.map(x=>({date:x.date,open:x.close,high:x.close,low:x.close,close:x.close,volume:0})));
}

function meanJS(a){return a.length?a.reduce((x,y)=>x+y,0)/a.length:0}
function stdevJS(a){if(a.length<2)return 0;const m=meanJS(a);return Math.sqrt(meanJS(a.map(x=>(x-m)**2)))}
function pctJS(a,b){return b?((a/b)-1)*100:0}
function retN(a,n){return a.length>n?pctJS(a[a.length-1],a[a.length-1-n]):0}
function dailyReturnsJS(a){return a.slice(1).map((x,i)=>x/a[i]-1)}
function analogueJS(closes){
 if(closes.length<100)return null;
 const rs=dailyReturnsJS(closes), currentM=retN(closes,20), currentV=stdevJS(rs.slice(-20))*Math.sqrt(252), horizons=[1,5,10,20,40], candidates=[];
 for(let i=60;i<closes.length-Math.max(...horizons);i++){
  const prefix=closes.slice(0,i+1), m=retN(prefix,20), v=stdevJS(rs.slice(Math.max(0,i-19),i+1))*Math.sqrt(252);
  const distance=Math.abs(m-currentM)/Math.max(1,Math.abs(currentM)+1)+Math.abs(v-currentV)/Math.max(10,currentV);
  if(distance>=1)continue;
  const outcomes={};let adverse=Infinity,favourable=-Infinity;
  for(const h of horizons){const end=Math.min(closes.length-1,i+h);if(end<=i)continue;const w=closes.slice(i+1,end+1);const r=pctJS(closes[end],closes[i]);outcomes[h]=r;adverse=Math.min(adverse,pctJS(Math.min(...w),closes[i]));favourable=Math.max(favourable,pctJS(Math.max(...w),closes[i]));}
  if(horizons.every(h=>Number.isFinite(outcomes[h])))candidates.push({distance,returns:outcomes,adverse,favourable});
 }
 const sample=candidates.sort((a,b)=>a.distance-b.distance).slice(0,100); if(sample.length<20)return null;
 const distributions={};
 for(const h of horizons){const vals=sample.map(x=>x.returns[h]).sort((a,b)=>a-b);distributions[h]={sample:vals.length,probability:Math.round(vals.filter(x=>x>0).length/vals.length*100),expected:+meanJS(vals).toFixed(3),median:+vals[Math.floor(vals.length/2)].toFixed(3),best:+Math.max(...vals).toFixed(3),worst:+Math.min(...vals).toFixed(3)};}
 const viable=horizons.filter(h=>distributions[h].probability>50&&distributions[h].expected>0);
 const bestH=viable.length?viable.sort((a,b)=>distributions[b].expected-distributions[a].expected)[0]:5;
 return {sample:sample.length,optimalHorizonDays:bestH,optimalProbability:distributions[bestH].probability,optimalExpected:distributions[bestH].expected,optimalWorst:distributions[bestH].worst,optimalBest:distributions[bestH].best,horizons:distributions,momentum:+currentM.toFixed(3),volatility:+currentV.toFixed(3)};
}
function structureBreakJS(closes,i,direction){if(i<3)return false;const a=closes[i-2],b=closes[i-1],c=closes[i];return direction==='LONG'?c<a&&b<=a:c>a&&b>=a}
function atrJS(closes,end,period=14){if(end<period)return 0;let sum=0;for(let i=end-period+1;i<=end;i++)sum+=Math.abs(closes[i]-(closes[i-1]??closes[i]));return sum/period}
function evaluateExitJS(closes,entryIndex,horizon,direction,model,stopLossPct,targetPct){const entry=closes[entryIndex];for(let j=1;j<=horizon&&entryIndex+j<closes.length;j++){const idx=entryIndex+j,price=closes[idx],move=direction==='LONG'?((price/entry)-1)*100:((entry/price)-1)*100;if(move<=-stopLossPct)return {reason:'STOP',price,bars:j};if(model==='FIXED_2R'&&move>=targetPct)return {reason:'TARGET',price,bars:j};if(model==='STRUCTURE_1H'&&j>=3&&structureBreakJS(closes,idx,direction))return {reason:'STRUCTURE_BREAK',price,bars:j};if(['ATR_2_5','ATR_3_0','HYBRID','ADAPTIVE'].includes(model)&&j>=14){const mult=model==='ATR_2_5'?2.5:3,a=atrJS(closes,idx),w=closes.slice(entryIndex,idx+1),extreme=direction==='LONG'?Math.max(...w):Math.min(...w),trail=direction==='LONG'?extreme-a*mult:extreme+a*mult;if((direction==='LONG'&&price<=trail)||(direction==='SHORT'&&price>=trail))return {reason:'ATR_TRAIL',price,bars:j}}if(model==='HYBRID'&&move>=targetPct*.75&&j>=3&&structureBreakJS(closes,idx,direction))return {reason:'STRUCTURE_BREAK',price,bars:j}}
 const fi=Math.min(closes.length-1,entryIndex+horizon);return {reason:'TIME',price:closes[fi],bars:fi-entryIndex};}
function runMacroBacktest(symbol,closes,exitModel){
 const trades=[];const cfg={minHistoricalProbability:55,minExpectedReturn:0.5,minQualificationScore:0,minHistoricalSample:20,stopLossPct:2,targetPct:4};
 for(let i=120;i<closes.length-45;i+=5){const an=analogueJS(closes.slice(0,i+1));if(!an||an.sample<cfg.minHistoricalSample)continue;const direction=an.optimalProbability>=50?'LONG':'SHORT',expected=direction==='LONG'?an.optimalExpected:-an.optimalExpected,prob=direction==='LONG'?an.optimalProbability:100-an.optimalProbability;if(prob<cfg.minHistoricalProbability||expected<cfg.minExpectedReturn)continue;const horizon=Math.min(40,Math.max(1,an.optimalHorizonDays)),entry=closes[i],ex=evaluateExitJS(closes,i,horizon,direction,exitModel,cfg.stopLossPct,cfg.targetPct),ret=direction==='LONG'?pctJS(ex.price,entry):pctJS(entry,ex.price);trades.push({direction,ret,bars:ex.bars,reason:ex.reason});}
 return summariseTrades(symbol,trades,closes.length,'MACRO 01 · Strategy 001');
}
function getBTConfig(){
 const s=document.getElementById('btStart').value,e=document.getElementById('btEnd').value;
 return {start:s,end:e,capital:Math.max(1000,Number(document.getElementById('btCapital').value)||100000),fast:Math.max(2,Number(document.getElementById('btFast').value)||5),slow:Math.max(3,Number(document.getElementById('btSlow').value)||20),spread:Math.max(0,Number(document.getElementById('btSpread').value)||0),slippage:Math.max(0,Number(document.getElementById('btSlippage').value)||0),fees:Math.max(0,Number(document.getElementById('btFees').value)||0)};
}
function btCostPct(cfg){return 2*(cfg.spread+cfg.slippage+cfg.fees)/100;}
function summariseTrades(symbol,trades,bars,strategy,cfg,dates){
 const rs=trades.map(t=>t.ret),wins=rs.filter(x=>x>0),losses=rs.filter(x=>x<=0),grossWin=wins.reduce((a,x)=>a+x,0),grossLoss=Math.abs(losses.reduce((a,x)=>a+x,0));
 let equity=cfg.capital,peak=equity,dd=0;
 for(const x of rs){equity*=1+x/100;peak=Math.max(peak,equity);dd=Math.max(dd,(peak-equity)/peak*100);}
 const daily={};trades.forEach(t=>{const d=t.exitDate||t.entryDate||'';daily[d]=(daily[d]||0)+t.ret/100;});
 const dr=Object.values(daily),avgD=dr.length?dr.reduce((a,x)=>a+x,0)/dr.length:0,sd=dr.length>1?Math.sqrt(dr.reduce((a,x)=>a+(x-avgD)*(x-avgD),0)/(dr.length-1)):0;
 const sharpe=sd?avgD/sd*Math.sqrt(252):0;
 return {symbol,strategy,bars,trades:rs.length,winRate:rs.length?wins.length/rs.length*100:0,averageReturn:rs.length?rs.reduce((a,x)=>a+x,0)/rs.length:0,totalReturn:(equity/cfg.capital-1)*100,pnl:equity-cfg.capital,endingCapital:equity,profitFactor:grossLoss?grossWin/grossLoss:0,maxDrawdown:dd,averageHold:rs.length?trades.reduce((a,t)=>a+t.bars,0)/rs.length:0,best:rs.length?Math.max(...rs):0,worst:rs.length?Math.min(...rs):0,sharpe,tradeList:trades,startDate:dates?.[0]||'',endDate:dates?.[dates.length-1]||'',costPct:btCostPct(cfg)};
}

const backtestHistory=[];
function toggleBacktestHistory(){const body=document.getElementById('backtestHistoryBody'),btn=document.querySelector('#backtestHistory button');if(!body||!btn)return;const hidden=body.style.display==='none';body.style.display=hidden?'':'none';btn.textContent=hidden?'HIDE HISTORY ▾':'SHOW HISTORY ▸';}
function renderBacktestHistory(){const body=document.getElementById('backtestHistoryBody');if(!body)return;if(!backtestHistory.length){body.textContent='No previous runs in this session.';return}body.innerHTML='<div style="overflow:auto"><table><thead><tr><th>#</th><th>STRATEGY</th><th>ASSET</th><th>WINDOW</th><th>RETURN</th><th>PF</th><th>SHARPE</th><th>MAX DD</th><th>TRADES</th></tr></thead><tbody>'+backtestHistory.slice().reverse().map((r,i)=>'<tr><td>'+(i+1)+'</td><td>'+r.strategy+'</td><td>'+r.symbol+'</td><td>'+r.startDate+' → '+r.endDate+'</td><td class="'+(r.totalReturn>=0?'good':'warn')+'">'+(r.totalReturn>=0?'+':'')+r.totalReturn.toFixed(2)+'%</td><td>'+r.profitFactor.toFixed(2)+'</td><td>'+r.sharpe.toFixed(2)+'</td><td>'+r.maxDrawdown.toFixed(2)+'%</td><td>'+r.trades+'</td></tr>').join('')+'</tbody></table></div>'}
const STRATEGY_LIBRARY={
 MA_CROSSOVER:{name:'MA Crossover',desc:'Simple moving-average trend crossover',params:'fast/slow'},
 EMA_MOMENTUM:{name:'EMA Momentum',desc:'EMA trend alignment plus momentum confirmation',params:'fast/slow/momentum'},
 RSI_MEAN_REVERSION:{name:'RSI Mean Reversion',desc:'Oversold/overbought reversal',params:'period/entry/exit'},
 RSI_MOMENTUM:{name:'RSI Momentum',desc:'RSI threshold momentum',params:'period/threshold'},
 MACD:{name:'MACD',desc:'MACD line versus signal line',params:'fast/slow/signal'},
 BREAKOUT:{name:'Breakout',desc:'N-bar price breakout',params:'lookback'},
 DONCHIAN:{name:'Donchian Breakout',desc:'Channel breakout with separate exit channel',params:'entry/exit'},
 BOLLINGER_REVERSION:{name:'Bollinger Mean Reversion',desc:'Band excursion and reversion',params:'period/z'},
 BOLLINGER_BREAKOUT:{name:'Bollinger Breakout',desc:'Band expansion breakout',params:'period/z'},
 ATR_BREAKOUT:{name:'ATR Breakout',desc:'Price expansion relative to ATR',params:'lookback/atrMult'},
 MOMENTUM:{name:'Momentum',desc:'N-bar rate-of-change momentum',params:'lookback/threshold'},
 TREND_MOMENTUM:{name:'Trend + Momentum',desc:'Trend filter plus momentum confirmation',params:'fast/slow/momentum'},
 TREND_VOLATILITY:{name:'Trend + Volatility',desc:'Trend plus ATR regime filter',params:'fast/slow/atrPeriod/atrMult'},
 MULTI_FACTOR:{name:'Multi-Factor',desc:'Trend + momentum + RSI confirmation',params:'fast/slow/momentum/rsi'},
 VWAP_REVERSION:{name:'VWAP Reversion',desc:'Unavailable until intraday OHLCV cache is present',params:'intraday only'},
 VOLUME_BREAKOUT:{name:'Volume Breakout',desc:'Unavailable until volume cache is present',params:'volume required'}
};
function labMean(a){return a.length?a.reduce((x,y)=>x+y,0)/a.length:0}
function labEMA(a,p){if(!a.length)return 0;const k=2/(p+1);let e=a[0];for(let i=1;i<a.length;i++)e=a[i]*k+e*(1-k);return e}
function labRSI(a,p){if(a.length<=p)return 50;let g=0,l=0;for(let i=a.length-p;i<a.length;i++){const d=a[i]-a[i-1];if(d>0)g+=d;else l-=d}if(l===0)return 100;const rs=(g/p)/(l/p);return 100-(100/(1+rs))}
function labATR(a,p){if(a.length<=p)return 0;let s=0;for(let i=a.length-p+1;i<a.length;i++)s+=Math.abs(a[i]-a[i-1]);return s/(p-1)}
function labStd(a){if(a.length<2)return 0;const m=labMean(a);return Math.sqrt(a.reduce((s,x)=>s+(x-m)*(x-m),0)/a.length)}
function labSignal(closes,i,type,p){
 const x=closes.slice(0,i),px=x[x.length-1];
 if(!x.length)return 0;
 if(type==='MA_CROSSOVER'){const f=labMean(x.slice(-p.fast)),s=labMean(x.slice(-p.slow));return f>s?1:-1}
 if(type==='EMA_MOMENTUM'){const w=x.slice(-Math.max(p.slow,p.momentum,50)),f=labEMA(w,p.fast),s=labEMA(w,p.slow),m=x.length>p.momentum?px/x[x.length-1-p.momentum]-1:0;return f>s&&m>0?1:f<s&&m<0?-1:0}
 if(type==='RSI_MEAN_REVERSION'){const r=labRSI(x,p.period);if(r<=p.entry)return 1;if(r>=100-p.entry)return -1;return 0}
 if(type==='RSI_MOMENTUM'){const r=labRSI(x,p.period);return r>=p.threshold?1:r<=100-p.threshold?-1:0}
 if(type==='MACD'){
  const w=x.slice(-Math.max(p.slow+p.signal+40,120)),kF=2/(p.fast+1),kS=2/(p.slow+1),mac=[];
  let ef=w[0],es=w[0];
  for(let j=1;j<w.length;j++){ef=w[j]*kF+ef*(1-kF);es=w[j]*kS+es*(1-kS);mac.push(ef-es)}
  if(mac.length<p.signal)return 0;
  const kSig=2/(p.signal+1);let sig=mac[0];for(let j=1;j<mac.length;j++)sig=mac[j]*kSig+sig*(1-kSig);
  const m=mac[mac.length-1];return m>sig?1:m<sig?-1:0;
 }
 if(type==='BREAKOUT'){const w=x.slice(-p.lookback-1,-1),hi=Math.max(...w),lo=Math.min(...w);return px>hi?1:px<lo?-1:0}
 if(type==='DONCHIAN'){const w=x.slice(-p.entry-1,-1),hi=Math.max(...w),lo=Math.min(...w);return px>hi?1:px<lo?-1:0}
 if(type==='BOLLINGER_REVERSION'){const w=x.slice(-p.period),m=labMean(w),sd=labStd(w),z=sd?(px-m)/sd:0;return z<=-p.z?1:z>=p.z?-1:0}
 if(type==='BOLLINGER_BREAKOUT'){const w=x.slice(-p.period),m=labMean(w),sd=labStd(w),z=sd?(px-m)/sd:0;return z>=p.z?1:z<=-p.z?-1:0}
 if(type==='ATR_BREAKOUT'){const atr=labATR(x,p.lookback),move=px-x[x.length-2];return atr&&move>atr*p.atrMult?1:atr&&move<-atr*p.atrMult?-1:0}
 if(type==='MOMENTUM'){const m=x.length>p.lookback?px/x[x.length-1-p.lookback]-1:0;return m>p.threshold?1:m<-p.threshold?-1:0}
 if(type==='TREND_MOMENTUM'){const w=x.slice(-Math.max(p.slow,p.momentum,100)),f=labEMA(w,p.fast),s=labEMA(w,p.slow),m=x.length>p.momentum?px/x[x.length-1-p.momentum]-1:0;return f>s&&m>p.threshold?1:f<s&&m<-p.threshold?-1:0}
 if(type==='TREND_VOLATILITY'){const w=x.slice(-Math.max(p.slow,p.atrPeriod,100)),f=labEMA(w,p.fast),s=labEMA(w,p.slow),atr=labATR(x,p.atrPeriod),base=labMean(x.slice(-p.atrPeriod));if(!atr||!base)return 0;return atr/base>=p.atrMult?(f>s?1:f<s?-1:0):0}
 if(type==='MULTI_FACTOR'){const w=x.slice(-Math.max(p.slow,p.momentum,p.rsi,100)),f=labEMA(w,p.fast),s=labEMA(w,p.slow),m=x.length>p.momentum?px/x[x.length-1-p.momentum]-1:0,r=labRSI(x,p.rsi);return f>s&&m>0&&r>=50?1:f<s&&m<0&&r<50?-1:0}
 return 0;
}
function labExit(closes,entryIndex,direction,model,p){
 // Backward-compatible argument handling: older builds passed (closes, entryIndex, model, p).
 if(typeof direction==='string'){
  p=model||{};
  model=direction;
  direction=1;
 }
 direction=direction===-1?-1:1;
 model=model||'TIME';
 p=p||{};
 const entry=closes[entryIndex],risk=Math.max(labATR(closes.slice(0,entryIndex+1),14),entry*0.005),atrMult=p.atrMult||2.5;
 const horizon=p.horizon||40;
 let best=entry;
 for(let j=1;j<=horizon&&entryIndex+j<closes.length;j++){
  const idx=entryIndex+j,px=closes[idx],move=direction===1?(px/entry-1):(entry/px-1);
  if(model==='FIXED_2R'&&move>=2*risk/entry)return {idx,px,reason:'2R_TARGET'};
  if(model==='ATR_TRAIL'){best=direction===1?Math.max(best,px):Math.min(best,px);const stop=direction===1?best-atrMult*risk:best+atrMult*risk;if((direction===1&&px<=stop)||(direction===-1&&px>=stop))return {idx,px,reason:'ATR_TRAIL'};}
  if(model==='STRUCTURE'&&j>=3){const prev=closes[idx-1];if(direction===1&&px<prev&&prev<closes[idx-2])return {idx,px,reason:'STRUCTURE'};if(direction===-1&&px>prev&&prev>closes[idx-2])return {idx,px,reason:'STRUCTURE'};}
  if(model==='TIME'&&j>=horizon)return {idx,px,reason:'TIME'};
 }
 const idx=Math.min(closes.length-1,entryIndex+horizon);return {idx,px:closes[idx],reason:'OPEN_AT_END'};
}
function labScenario(closes,dates,type,p,exitModel,cfg){
 const trades=[];let side=0,entryIndex=-1,entryPrice=0;
 const warm=Math.max(30,p.slow||0,p.lookback||0,p.period||0,p.atrPeriod||0,p.entry||0);
 for(let i=warm;i<closes.length;i++){
  const sig=labSignal(closes,i,type,p);
  if(side===0&&sig!==0){side=sig;entryIndex=i;entryPrice=closes[i];continue}
  if(side!==0&&(sig===-side||(type==='RSI_MEAN_REVERSION'&&sig===0))){
   const ex=labExit(closes,entryIndex,side,exitModel,p),gross=side===1?pctJS(ex.px,entryPrice):pctJS(entryPrice,ex.px),ret=gross-btCostPct(cfg);
   trades.push({direction:side===1?'LONG':'SHORT',ret,bars:ex.idx-entryIndex,reason:ex.reason,entryDate:dates[entryIndex],exitDate:dates[ex.idx],entryPrice,exitPrice:ex.px});
   side=0;entryIndex=-1;
   if(sig!==0){side=sig;entryIndex=i;entryPrice=closes[i]}
  }
 }
 if(side!==0&&entryIndex>=0){const ex=labExit(closes,entryIndex,side,'TIME',{horizon:Math.min(40,closes.length-entryIndex-1),atrMult:2.5}),gross=side===1?pctJS(ex.px,entryPrice):pctJS(entryPrice,ex.px);trades.push({direction:side===1?'LONG':'SHORT',ret:gross-btCostPct(cfg),bars:ex.idx-entryIndex,reason:'END_OF_TEST',entryDate:dates[entryIndex],exitDate:dates[ex.idx],entryPrice,exitPrice:ex.px})}
 const r=summariseTrades('',trades,closes.length,'TECHNICAL LAB · '+STRATEGY_LIBRARY[type].name,cfg,dates);
 // A valid scenario is still a result even when its trade count is zero; filters decide qualification.
 return r?{...r,type,params:p,exitModel}:null;
}
function labGrid(type,stage){
 const coarse={
  MA_CROSSOVER:{fast:[3,5,10,20],slow:[20,50,100]},
  EMA_MOMENTUM:{fast:[5,10,20],slow:[20,50,100],momentum:[5,10,20]},
  RSI_MEAN_REVERSION:{period:[7,14,21],entry:[20,25,30]},
  RSI_MOMENTUM:{period:[7,14,21],threshold:[50,55,60]},
  MACD:{fast:[8,12,16],slow:[21,26,34],signal:[5,9]},
  BREAKOUT:{lookback:[10,20,40,60,100]},
  DONCHIAN:{entry:[20,40,55,100]},
  BOLLINGER_REVERSION:{period:[10,20,30],z:[1.5,2,2.5]},
  BOLLINGER_BREAKOUT:{period:[10,20,30],z:[1.5,2,2.5]},
  ATR_BREAKOUT:{lookback:[10,14,20],atrMult:[0.75,1,1.5,2]},
  MOMENTUM:{lookback:[5,10,20,40,60],threshold:[0.01,0.02,0.03]},
  TREND_MOMENTUM:{fast:[5,10,20],slow:[30,50,100],momentum:[5,10,20],threshold:[0,0.01,0.02]},
  TREND_VOLATILITY:{fast:[10,20],slow:[50,100],atrPeriod:[14,20],atrMult:[0.005,0.01,0.02]},
  MULTI_FACTOR:{fast:[5,10,20],slow:[30,50,100],momentum:[5,10,20],rsi:[7,14,21]}
 };
 const deep={
  MA_CROSSOVER:{fast:[2,3,4,5,6,8,10,12,15,20,25,30],slow:[20,30,40,50,60,75,100,125,150,200]},
  EMA_MOMENTUM:{fast:[3,5,8,10,15,20,25],slow:[20,30,40,50,75,100,150],momentum:[3,5,8,10,15,20,30]},
  RSI_MEAN_REVERSION:{period:[5,7,9,14,21,28],entry:[15,20,25,30,35,40]},
  RSI_MOMENTUM:{period:[5,7,9,14,21,28],threshold:[50,52,55,58,60,65]},
  MACD:{fast:[5,8,10,12,16,20],slow:[20,21,26,30,34,40,50],signal:[3,5,7,9,12]},
  BREAKOUT:{lookback:[5,10,15,20,30,40,55,75,100,150,200]},
  DONCHIAN:{entry:[10,15,20,30,40,55,75,100,150,200]},
  BOLLINGER_REVERSION:{period:[10,15,20,25,30,40,50],z:[1,1.25,1.5,1.75,2,2.25,2.5]},
  BOLLINGER_BREAKOUT:{period:[10,15,20,25,30,40,50],z:[1,1.25,1.5,1.75,2,2.25,2.5]},
  ATR_BREAKOUT:{lookback:[5,7,10,14,20,30,40],atrMult:[0.5,0.75,1,1.25,1.5,2,2.5,3]},
  MOMENTUM:{lookback:[3,5,8,10,15,20,30,40,60,90,120],threshold:[0,0.005,0.01,0.02,0.03,0.05]},
  TREND_MOMENTUM:{fast:[3,5,8,10,15,20,25],slow:[20,30,40,50,75,100,150,200],momentum:[3,5,8,10,15,20,30,40],threshold:[0,0.005,0.01,0.02,0.03]},
  TREND_VOLATILITY:{fast:[5,10,15,20,30],slow:[30,50,75,100,150,200],atrPeriod:[7,10,14,20,30],atrMult:[0.0025,0.005,0.0075,0.01,0.015,0.02]},
  MULTI_FACTOR:{fast:[3,5,8,10,15,20],slow:[30,40,50,75,100,150],momentum:[3,5,8,10,15,20,30],rsi:[5,7,9,14,21,28]}
 };
 const g=stage==='deep'?deep[type]:coarse[type];if(!g)return[];
 const keys=Object.keys(g),out=[];
 const walk=(i,o)=>{if(i===keys.length){if(o.fast&&o.slow&&o.fast>=o.slow)return;out.push({...o});return}for(const v of g[keys[i]])walk(i+1,{...o,[keys[i]]:v})};
 walk(0,{});
 return out;
}
function labFilter(r,f){return r&&r.trades>=f.minTrades&&r.totalReturn>=f.minReturn&&r.profitFactor>=f.minPF&&r.sharpe>=f.minSharpe&&r.maxDrawdown<=f.maxDD}
function labRank(arr,metric){return arr.sort((a,b)=>{const av=metric==='maxDrawdown'?a.result.maxDrawdown:a.result[metric],bv=metric==='maxDrawdown'?b.result.maxDrawdown:b.result[metric];return metric==='maxDrawdown'?av-bv:bv-av})}
function initLabProgress(context){
 const key=String(context||'default');
 if(window.__mteLabProgressContext!==key||!window.__mteLabProgress){
  window.__mteLabProgressContext=key;
  window.__mteLabProgress={discovery:0,deep:0,robust:0};
 }
 return window.__mteLabProgress;
}
function labProgressHTML(activeStage){
 const p=window.__mteLabProgress||{discovery:0,deep:0,robust:0};
 const active=activeStage||window.__mteActiveLabStage||'discovery';
 const rows=[
  ['discovery','STAGE 1 · DISCOVERY'],
  ['deep','STAGE 2 · DEEP OPTIMISATION'],
  ['robust','STAGE 3 · ROBUSTNESS']
 ];
 return '<div id="strategyLabProgress" class="box" style="margin-top:15px"><h3>STRATEGY LAB PROGRESS</h3>'+rows.map(([key,label])=>{
  const value=Math.max(0,Math.min(100,Number(p[key]||0)));
  const state=key===active?' · ACTIVE':value>=100?' · COMPLETE':' · PENDING';
  return '<div style="margin:10px 0"><div style="display:flex;justify-content:space-between;font-size:12px;font-weight:700;margin-bottom:5px"><span>'+label+state+'</span><span>'+Math.round(value)+'%</span></div><div style="height:12px;background:#e9edf2;border-radius:7px;overflow:hidden"><div style="height:100%;width:'+value+'%;background:#1f2937;border-radius:7px;transition:width .15s ease"></div></div></div>';
 }).join('')+'</div>';
}
function mteEnsureCollapsible(el){
 if(!el)return;
 if(el.querySelector(':scope > .mte-collapse-head'))return;
 const h=el.querySelector(':scope > h3'); if(!h)return;
 const title=h.textContent, body=document.createElement('div'), head=document.createElement('div'), titleEl=document.createElement('h3'), btn=document.createElement('button');
 body.className='mte-collapse-body'; head.className='mte-collapse-head'; titleEl.textContent=title;
 btn.type='button';btn.className='mte-collapse-toggle';btn.textContent='⌃';btn.title='Collapse section';
 h.remove();
 while(el.firstChild)body.appendChild(el.firstChild);
 btn.onclick=()=>{const hidden=body.classList.toggle('is-collapsed');btn.textContent=hidden?'⌄':'⌃';btn.title=(hidden?'Expand ':'Collapse ')+title+' section';};
 head.appendChild(titleEl);head.appendChild(btn);el.innerHTML='';el.classList.add('mte-collapsible-result');el.appendChild(head);el.appendChild(body);
 if(el.id==='backtestResults')body.classList.add('mte-results-grid');
}
function updateLabProgress(patch){
 window.__mteLabProgress={...(window.__mteLabProgress||{discovery:0,deep:0,robust:0}),...patch};
 const active=window.__mteActiveLabStage||'discovery';
 const old=document.getElementById('strategyLabProgress');
 if(old)old.outerHTML=labProgressHTML(active);
 else{
  const panel=document.getElementById('optimisationResults');
  if(panel)panel.insertAdjacentHTML('beforebegin',labProgressHTML(active));
 }
}
async function runStrategyDiscovery(){
 const asset=document.getElementById('btAsset')?.value,cfg=getBTConfig(),stage=document.getElementById('labStage')?.value||'discovery';
 window.__mteActiveLabStage=stage;
 const f={minTrades:Math.max(0,Number(document.getElementById('optMinTrades')?.value)||0),minReturn:Number(document.getElementById('optMinReturn')?.value)||0,minPF:Math.max(0,Number(document.getElementById('optMinPF')?.value)||0),minSharpe:Number(document.getElementById('optMinSharpe')?.value)||0,maxDD:Math.max(0,Number(document.getElementById('optMaxDD')?.value)||100),rankBy:document.getElementById('optRankBy')?.value||'totalReturn',topN:Math.max(1,Number(document.getElementById('labTopN')?.value)||10)};
 const families=Array.from(document.querySelectorAll('.lab-family:checked')).map(x=>x.value),exits=Array.from(document.querySelectorAll('.lab-exit:checked')).map(x=>x.value);
 let panel=document.getElementById('optimisationResults');if(!panel){panel=document.createElement('div');panel.id='optimisationResults';panel.className='box';panel.style.marginTop='15px';document.getElementById('backtestResults').parentNode.insertBefore(panel,document.getElementById('btTrades'))}
 const status=document.getElementById('backtestStatus'),explain=document.getElementById('btExplanation');
 initLabProgress('technical|'+asset);
 status.textContent='LAB RUNNING';panel.innerHTML='<h3>TECHNICAL STRATEGY LAB · '+stage.toUpperCase()+'</h3><div class="sub">Preparing '+asset+'…</div>';mteEnsureCollapsible(panel);
 try{
  const all=await fetchYahooHistory(asset),filtered=all.filter(x=>(!cfg.start||x.date>=cfg.start)&&(!cfg.end||x.date<=cfg.end)),dates=filtered.map(x=>x.date),closes=filtered.map(x=>x.close);
  if(closes.length<120)throw new Error('At least 120 observations are required for Strategy Lab.');
  if(!families.length)throw new Error('Select at least one strategy family.');
  if(!exits.length)throw new Error('Select at least one exit model.');
  const allResults=[],qualified=[],familyBest={},errors=[];
  let scenarioCount=0;
  const runScenario=async(type,p,exit)=>{
   scenarioCount++;
   try{
    const r=labScenario(closes,dates,type,p,exit,cfg);
    if(r){
     const item={result:r};
     allResults.push(item);
     if(labFilter(r,f))qualified.push(item);
     if(!familyBest[type]||labRank([item,familyBest[type]],f.rankBy)[0]===item)familyBest[type]=item;
     return item;
    }
   }catch(err){errors.push({type,p,exit,error:String(err?.message||err)})}
   return null;
  };
  const usableFamilies=families.filter(type=>STRATEGY_LIBRARY[type]&&type!=='VWAP_REVERSION'&&type!=='VOLUME_BREAKOUT');
  const discoveryTotal=usableFamilies.reduce((n,type)=>n+labGrid(type,'discovery').length*exits.length,0);
  const discoveryBest=[];
  for(const type of usableFamilies){
   const grids=labGrid(type,'discovery');
   for(const p of grids)for(const exit of exits){
    await runScenario(type,p,exit);
    updateLabProgress({discovery:discoveryTotal?scenarioCount/discoveryTotal*100:100});
    if(scenarioCount%20===0){
     panel.innerHTML='<h3>TECHNICAL STRATEGY LAB · '+stage.toUpperCase()+'</h3><div class="row"><span>Asset / window</span><b>'+asset+' · '+dates[0]+' → '+dates[dates.length-1]+'</b></div><div class="row"><span>Scenarios processed</span><b>'+scenarioCount.toLocaleString()+'</b></div><div class="row"><span>Results generated</span><b>'+allResults.length.toLocaleString()+'</b></div><div class="sub">Running '+STRATEGY_LIBRARY[type].name+'…</div>';mteEnsureCollapsible(panel);
     await new Promise(resolve=>setTimeout(resolve,0));
    }
   }
   if(familyBest[type])discoveryBest.push(familyBest[type]);
   await new Promise(resolve=>setTimeout(resolve,0));
  }
  labRank(discoveryBest,f.rankBy);
  updateLabProgress({discovery:100});
  let finalResults=allResults;
  if(stage==='deep'||stage==='robust'){
   const selectedTypes=discoveryBest.slice(0,Math.max(3,f.topN)).map(x=>x.result.type);
   const deepTotal=selectedTypes.reduce((n,type)=>n+labGrid(type,'deep').length*exits.length,0);
   let deepDone=0;
   finalResults=[];
   for(const type of selectedTypes){
    const grids=labGrid(type,'deep');
    for(const p of grids)for(const exit of exits){
     const item=await runScenario(type,p,exit);
     if(item)finalResults.push(item);
     deepDone++;
     updateLabProgress({deep:deepTotal?deepDone/deepTotal*100:100});
     if(scenarioCount%20===0){
      panel.innerHTML='<h3>TECHNICAL STRATEGY LAB · '+stage.toUpperCase()+'</h3><div class="row"><span>Scenarios processed</span><b>'+scenarioCount.toLocaleString()+'</b></div><div class="row"><span>Results generated</span><b>'+allResults.length.toLocaleString()+'</b></div><div class="sub">Deep optimisation: '+STRATEGY_LIBRARY[type].name+'…</div>';mteEnsureCollapsible(panel);
      await new Promise(resolve=>setTimeout(resolve,0));
     }
    }
   }
   updateLabProgress({deep:100});
  }
  if(stage==='robust'){
   const base=labRank(finalResults.length?finalResults:discoveryBest,f.rankBy).slice(0,Math.max(3,f.topN));
   return await runStrategyRobustness(asset,closes,dates,cfg,f,base,panel,status,explain);
  }
  const source=stage==='discovery'?discoveryBest:finalResults;
  labRank(source,f.rankBy);
  const filteredSource=source.filter(x=>labFilter(x.result,f));
  const displayTop=(filteredSource.length?filteredSource:source).slice(0,f.topN);
  const filterState=filteredSource.length?'FILTERS PASSED':'NO SCENARIO PASSED FILTERS — SHOWING BEST RAW RESULTS';
  const rows=displayTop.map((x,i)=>'<tr><td>'+(i+1)+'</td><td>'+STRATEGY_LIBRARY[x.result.type].name+'</td><td>'+Object.entries(x.result.params).map(([k,v])=>k+'='+v).join(' · ')+'</td><td>'+x.result.exitModel+'</td><td>'+x.result.trades+'</td><td class="'+(x.result.totalReturn>=0?'good':'warn')+'">'+(x.result.totalReturn>=0?'+':'')+x.result.totalReturn.toFixed(2)+'%</td><td>'+x.result.profitFactor.toFixed(2)+'</td><td>'+x.result.sharpe.toFixed(2)+'</td><td>'+x.result.maxDrawdown.toFixed(2)+'%</td><td>'+x.result.winRate.toFixed(1)+'%</td></tr>').join('');
  panel.innerHTML='<h3>TECHNICAL STRATEGY LAB · '+(stage==='discovery'?'STAGE 1 · DISCOVERY':'STAGE 2 · DEEP OPTIMISATION')+'</h3><div class="row"><span>Asset / window</span><b>'+asset+' · '+dates[0]+' → '+dates[dates.length-1]+'</b></div><div class="row"><span>Scenarios processed</span><b>'+scenarioCount.toLocaleString()+'</b></div><div class="row"><span>Results generated</span><b>'+allResults.length.toLocaleString()+'</b></div><div class="row"><span>Passing filters</span><b>'+qualified.length.toLocaleString()+'</b></div><div class="row"><span>Errors / skipped</span><b>'+errors.length.toLocaleString()+'</b></div><div class="sub" style="margin-top:8px"><b>'+filterState+'</b></div><div style="overflow:auto;margin-top:12px"><table><thead><tr><th>RANK</th><th>STRATEGY</th><th>PARAMETERS</th><th>EXIT</th><th>TRADES</th><th>RETURN</th><th>PF</th><th>SHARPE</th><th>MAX DD</th><th>WIN %</th></tr></thead><tbody>'+rows+'</tbody></table></div><div class="sub" style="margin-top:10px">Discovery compares genuine daily-close strategy logic. Stage 2 deep-searches the strongest strategy families. Filters qualify results but never hide the best raw results. The standard RUN BACKTEST engine was not modified.</div>';mteEnsureCollapsible(panel);
  if(displayTop[0]){
   const b=displayTop[0].result;
   explain.innerHTML='<b>LAB COMPLETE</b><br>'+STRATEGY_LIBRARY[b.type].name+' · '+Object.entries(b.params).map(([k,v])=>k+' '+v).join(' / ')+' · '+b.exitModel+' · '+(b.totalReturn>=0?'+':'')+b.totalReturn.toFixed(2)+'% return.';
  }else explain.textContent='STRATEGY LAB COMPLETE · No valid scenarios were generated.';
  status.textContent='LAB COMPLETE';
 }catch(e){console.error('Strategy Lab failed',e);panel.innerHTML='<h3>STRATEGY LAB FAILED</h3><div class="sub">'+(e?.message||String(e))+'</div>';mteEnsureCollapsible(panel);explain.textContent='STRATEGY LAB FAILED · '+(e?.message||String(e));status.textContent='ERROR'}
}
function labCostSensitivity(closes,dates,r,cfg){
 const out=[];
 for(const mult of [1,1.5,2,3]){
  const cc={...cfg,spread:Number(cfg.spread||0)*mult,slippage:Number(cfg.slippage||0)*mult,fees:Number(cfg.fees||0)*mult};
  const rr=labScenario(closes,dates,r.type,r.params,r.exitModel,cc);
  if(rr)out.push({mult,result:rr});
 }
 return out;
}
function labWalkForward(closes,dates,r,cfg){
 const folds=[],n=closes.length,trainLen=Math.max(120,Math.floor(n*.55)),testLen=Math.max(40,Math.floor(n*.12));
 for(let s=0;s+trainLen+testLen<=n&&folds.length<4;s+=testLen){
  const test=labScenario(closes.slice(s+trainLen,s+trainLen+testLen),dates.slice(s+trainLen,s+trainLen+testLen),r.type,r.params,r.exitModel,cfg);
  if(test)folds.push(test);
 }
 return folds;
}
function labRegimeSummary(closes,dates,r,cfg){
 const rr=labScenario(closes,dates,r.type,r.params,r.exitModel,cfg),b={BULL:[],BEAR:[],RANGE:[]};
 if(!rr?.tradeList)return b;
 for(const t of rr.tradeList){
  const i=Math.max(0,dates.indexOf(t.entryDate)),n=Math.min(50,i),ma=n?meanJS(closes.slice(i-n,i)):0;
  const prev=n>10?meanJS(closes.slice(i-n,i-10)):ma,px=closes[Math.max(0,i-1)];
  const k=px>ma&&ma>prev?'BULL':px<ma&&ma<prev?'BEAR':'RANGE';
  b[k].push(Number(t.ret||0));
 }
 return b;
}
function labStability(closes,dates,r,cfg){
 const vals=[];
 for(const [k,v0] of Object.entries(r.params||{})){
  const v=Number(v0);if(!Number.isFinite(v)||v===0)continue;
  for(const factor of [.9,1.1]){
   const p={...r.params,[k]:Number.isInteger(v)?Math.round(v*factor):v*factor};
   if(p.fast&&p.slow&&p.fast>=p.slow)continue;
   const rr=labScenario(closes,dates,r.type,p,r.exitModel,cfg);if(rr)vals.push(rr.totalReturn);
  }
 }
 const mean=vals.length?vals.reduce((a,x)=>a+x,0)/vals.length:0,sd=vals.length>1?Math.sqrt(vals.reduce((a,x)=>a+(x-mean)**2,0)/(vals.length-1)):0;
 return {mean,sd,total:vals.length,profitable:vals.filter(x=>x>0).length,score:vals.length?Math.max(0,Math.min(1,(vals.filter(x=>x>0).length/vals.length)*.5+(1/(1+sd/Math.max(1,Math.abs(r.totalReturn))))*.5)):0};
}
async function runStrategyRobustness(asset,closes,dates,cfg,f,top,panel,status,explain){
 const rows=[];
 const robustTotal=Math.max(3,f.topN);
 let robustDone=0;
 updateLabProgress({robust:0});
 for(const c of top.slice(0,robustTotal)){
  const r=c.result,split=Math.max(120,Math.floor(closes.length*.7));
  const oos=labScenario(closes.slice(split),dates.slice(split),r.type,r.params,r.exitModel,cfg);
  const stab=labStability(closes,dates,r,cfg),wf=labWalkForward(closes,dates,r,cfg),cost=labCostSensitivity(closes,dates,r,cfg),reg=labRegimeSummary(closes,dates,r,cfg);
  const positiveWF=wf.filter(x=>x.totalReturn>0).length,c2=cost.find(x=>x.mult===2)?.result,c3=cost.find(x=>x.mult===3)?.result;
  const robust=r.trades>=20&&oos&&oos.trades>=5&&(oos.profitFactor||0)>=1.05&&stab.score>=.55&&(wf.length?positiveWF/wf.length>=.5:false)&&c2&&c2.totalReturn>0;
  rows.push({r,oos,stab,wf,positiveWF,c2,c3,reg,robust});
  robustDone++;
  updateLabProgress({robust:robustDone/Math.min(robustTotal,top.length)*100});
  await new Promise(resolve=>setTimeout(resolve,0));
 }
 updateLabProgress({robust:100});
 rows.sort((a,b)=>(Number(b.robust)-Number(a.robust))||(b.stab.score-a.stab.score)||((b.oos?.profitFactor||0)-(a.oos?.profitFactor||0)));
 const body=rows.map((x,i)=>'<tr><td>'+(i+1)+'</td><td>'+STRATEGY_LIBRARY[x.r.type].name+'</td><td>'+Object.entries(x.r.params).map(([k,v])=>k+'='+v).join(' · ')+'</td><td>'+x.r.totalReturn.toFixed(2)+'%</td><td>'+(x.oos?.totalReturn||0).toFixed(2)+'%</td><td>'+(x.oos?.profitFactor||0).toFixed(2)+'</td><td>'+Math.round(x.stab.score*100)+'%</td><td>'+x.positiveWF+'/'+x.wf.length+'</td><td>'+(x.c2?.totalReturn||0).toFixed(2)+'%</td><td>'+(x.c3?.totalReturn||0).toFixed(2)+'%</td><td>'+Object.entries(x.reg).map(([k,v])=>k+': '+v.length+'T/'+v.reduce((a,z)=>a+z,0).toFixed(1)+'%').join(' · ')+'</td><td><b>'+(x.robust?'ROBUST CANDIDATE':'REQUIRES VALIDATION')+'</b></td></tr>').join('');
 const profiles=rows.map((x,i)=>'<div class="box" style="margin-top:10px"><h4>CANDIDATE '+(i+1)+' · '+STRATEGY_LIBRARY[x.r.type].name+'</h4><div class="row"><span>Parameters</span><b>'+Object.entries(x.r.params).map(([k,v])=>k+'='+v).join(' · ')+'</b></div><div class="row"><span>In-sample / OOS return</span><b>'+x.r.totalReturn.toFixed(2)+'% / '+(x.oos?.totalReturn||0).toFixed(2)+'%</b></div><div class="row"><span>OOS PF / trades</span><b>'+(x.oos?.profitFactor||0).toFixed(2)+' / '+(x.oos?.trades||0)+'</b></div><div class="row"><span>Parameter stability</span><b>'+Math.round(x.stab.score*100)+'% · '+x.stab.profitable+'/'+x.stab.total+' neighbours profitable</b></div><div class="row"><span>Walk-forward</span><b>'+x.positiveWF+'/'+x.wf.length+' positive windows</b></div><div class="row"><span>Cost sensitivity</span><b>2× '+(x.c2?.totalReturn||0).toFixed(2)+'% · 3× '+(x.c3?.totalReturn||0).toFixed(2)+'%</b></div><div class="row"><span>Regime returns</span><b>'+Object.entries(x.reg).map(([k,v])=>k+' '+v.reduce((a,z)=>a+z,0).toFixed(1)+'%').join(' · ')+'</b></div><div class="row"><span>Candidate status</span><b>'+(x.robust?'ROBUST CANDIDATE':'REQUIRES FURTHER VALIDATION')+'</b></div></div>').join('');
 panel.innerHTML='<h3>TECHNICAL STRATEGY LAB · STAGE 3 · ROBUSTNESS & VALIDATION</h3><div class="row"><span>Validation candidates</span><b>'+rows.length+'</b></div><div class="sub" style="margin:10px 0">Validation separates historical fit from robustness: 70/30 out-of-sample testing, parameter stability, rolling walk-forward consistency, regime behaviour and 1×/1.5×/2×/3× execution-cost sensitivity.</div><div style="overflow:auto"><table><thead><tr><th>RANK</th><th>STRATEGY</th><th>PARAMETERS</th><th>IS RETURN</th><th>OOS RETURN</th><th>OOS PF</th><th>STABILITY</th><th>WF POSITIVE</th><th>2× COST</th><th>3× COST</th><th>REGIME</th><th>STATUS</th></tr></thead><tbody>'+body+'</tbody></table></div>'+profiles;mteEnsureCollapsible(panel);
 if(rows[0])explain.innerHTML='<b>ROBUSTNESS COMPLETE</b><br>'+STRATEGY_LIBRARY[rows[0].r.type].name+' · OOS PF '+(rows[0].oos?.profitFactor||0).toFixed(2)+' · stability '+Math.round(rows[0].stab.score*100)+'% · '+(rows[0].robust?'ROBUST CANDIDATE':'REQUIRES FURTHER VALIDATION')+'.';
 else explain.textContent='ROBUSTNESS COMPLETE · No validation candidates were generated.';
 status.textContent='ROBUSTNESS COMPLETE';
}
function initStrategyLabFamilies(){
 const box=document.getElementById('strategyFamilyChecks');if(!box||box.dataset.ready)return;
 const usable=Object.keys(STRATEGY_LIBRARY).filter(x=>x!=='VWAP_REVERSION'&&x!=='VOLUME_BREAKOUT');
 box.innerHTML=usable.map(x=>'<label style="display:flex;align-items:center;gap:7px;font-size:11px"><input type="checkbox" class="lab-family" value="'+x+'" checked> '+STRATEGY_LIBRARY[x].name+'</label>').join('');
 box.dataset.ready='1';
}
initStrategyLabFamilies();

function technicalRun(closes,dates,fast,slow,cfg){
 if(fast>=slow||closes.length<slow+5)return null;
 const trades=[];let prev=null,entryIndex=-1,entryPrice=0;
 for(let i=slow;i<closes.length;i++){
  const fastM=meanJS(closes.slice(i-fast,i)),slowM=meanJS(closes.slice(i-slow,i)),dir=fastM>slowM?'LONG':'SHORT';
  if(prev===null){prev=dir;entryIndex=i;entryPrice=closes[i];continue;}
  if(dir!==prev){
   const gross=prev==='LONG'?pctJS(closes[i],entryPrice):pctJS(entryPrice,closes[i]),ret=gross-btCostPct(cfg);
   trades.push({direction:prev,ret,bars:i-entryIndex,reason:'TREND_FLIP',entryDate:dates[entryIndex],exitDate:dates[i],entryPrice,exitPrice:closes[i]});
   prev=dir;entryIndex=i;entryPrice=closes[i];
  }
 }
 if(prev&&entryIndex>=0){const last=closes.length-1,gross=prev==='LONG'?pctJS(closes[last],entryPrice):pctJS(entryPrice,closes[last]),ret=gross-btCostPct(cfg);trades.push({direction:prev,ret,bars:last-entryIndex,reason:'OPEN_AT_END',entryDate:dates[entryIndex],exitDate:dates[last],entryPrice,exitPrice:closes[last]});}
 return summariseTrades('',trades,closes.length,'TECHNICAL 01 · Strategy 002',cfg,dates);
}
function optimiseTechnical(closes,dates,cfg){
 const split=Math.max(cfg.slow+10,Math.floor(closes.length*.7)),trainC={...cfg},pairs=[];
 for(const fast of [3,5,8,10,15,20])for(const slow of [10,20,30,50,75,100])if(fast<slow&&slow<split){
  const r=technicalRun(closes.slice(0,split),dates.slice(0,split),fast,slow,trainC);if(r)pairs.push({fast,slow,score:r.totalReturn,sharpe:r.sharpe,trades:r.trades});
 }
 pairs.sort((a,b)=>b.score-a.score);
 return {split,pairs,best:pairs[0]||{fast:cfg.fast,slow:cfg.slow}};
}
function runTechnicalBacktest(symbol,closes,dates,cfg){
 const opt=optimiseTechnical(closes,dates,cfg),fast=cfg.fast,slow=cfg.slow,split=opt.split;
 const all=technicalRun(closes,dates,fast,slow,cfg);
 const train=technicalRun(closes.slice(0,split),dates.slice(0,split),fast,slow,cfg);
 const test=technicalRun(closes.slice(split),dates.slice(split),fast,slow,cfg);
 return {...all,fast,slow,train,test,optimisation:opt};
}
function runMacroBacktest(symbol,closes,dates,exitModel,cfg){
 const trades=[],baseCost=btCostPct(cfg);
 const start=120;
 for(let i=start;i<closes.length-45;i+=5){
  const an=analogueJS(closes.slice(0,i+1));if(!an||an.sample<20)continue;
  const direction=an.optimalProbability>=50?'LONG':'SHORT',expected=direction==='LONG'?an.optimalExpected:-an.optimalExpected,prob=direction==='LONG'?an.optimalProbability:100-an.optimalProbability;
  if(prob<55||expected<0.5)continue;
  const horizon=Math.min(40,Math.max(1,an.optimalHorizonDays)),entry=closes[i],ex=evaluateExitJS(closes,i,horizon,direction,exitModel,2,4),gross=direction==='LONG'?pctJS(ex.price,entry):pctJS(entry,ex.price);
  trades.push({direction,ret:gross-baseCost,bars:ex.bars,reason:ex.reason,entryDate:dates[i],exitDate:dates[Math.min(i+ex.bars,dates.length-1)],entryPrice:entry,exitPrice:ex.price});
 }
 return summariseTrades(symbol,trades,closes.length,'MACRO 01 · Strategy 001',cfg,dates);
}
async function runBacktest(){
 const runId=(window.__mteBacktestRunId||0)+1;window.__mteBacktestRunId=runId;
 const strategy=document.getElementById('btStrategy').value,asset=document.getElementById('btAsset').value,exit=document.getElementById('btExit').value,tf=document.getElementById('btTimeframe').value,cfg=getBTConfig();
 const status=document.getElementById('backtestStatus'),runButton=document.querySelector('.backtest-controls .primary');
 if(runButton){runButton.disabled=true;runButton.textContent='RUNNING BACKTEST…';}
 status.textContent='LOADING';
 const results=document.getElementById('backtestResults'),tradesPanel=document.getElementById('btTrades');if(results){results.classList.remove('mte-expanded-results');results.style.display='grid';}
 results.innerHTML='<div class="box"><h3>LOADING HISTORICAL DATA</h3><div class="sub">'+asset+' · committed MTE historical cache.</div></div>';mteEnsureCollapsible(results);
 tradesPanel.innerHTML='';const oldOptimisation=document.getElementById('optimisationResults');if(oldOptimisation)oldOptimisation.remove();
 try{
  const allBars=await fetchYahooHistory(asset),filtered=allBars.filter(x=>(!cfg.start||x.date>=cfg.start)&&(!cfg.end||x.date<=cfg.end));
  if(filtered.length<60)throw new Error('Selected date range contains fewer than 60 historical observations.');
  const dates=filtered.map(x=>x.date),closes=filtered.map(x=>x.close);
  const result=strategy==='macro'?runMacroBacktest(asset,closes,dates,exit,cfg):runTechnicalBacktest(asset,closes,dates,cfg);if(!result)throw new Error('Insufficient historical data for this test.');
  status.textContent='COMPLETED';let extra='';
  results.innerHTML='<div class="box"><h3>'+asset+' · '+result.strategy+'</h3><div class="row"><span>Strategy</span><b>'+result.strategy+'</b></div><div class="row"><span>Asset</span><b>'+asset+'</b></div><div class="row"><span>Test window</span><b>'+dates[0]+' → '+dates[dates.length-1]+'</b></div><div class="row"><span>Historical bars</span><b>'+result.bars.toLocaleString()+'</b></div><div class="row"><span>Trades</span><b>'+result.trades+'</b></div><div class="row"><span>Win rate</span><b>'+result.winRate.toFixed(1)+'%</b></div><div class="row"><span>Average return / trade</span><b class="'+(result.averageReturn>=0?'good':'warn')+'">'+(result.averageReturn>=0?'+':'')+result.averageReturn.toFixed(2)+'%</b></div><div class="row"><span>Best trade</span><b class="good">'+(result.best>=0?'+':'')+result.best.toFixed(2)+'%</b></div><div class="row"><span>Worst trade</span><b class="warn">'+result.worst.toFixed(2)+'%</b></div></div>'+
   '<div class="box"><h3>PERFORMANCE</h3><div class="row"><span>Total return</span><b>'+(result.totalReturn>=0?'+':'')+result.totalReturn.toFixed(2)+'%</b></div><div class="row"><span>P&amp;L</span><b>'+(result.pnl>=0?'+':'')+'$'+result.pnl.toFixed(2)+'</b></div><div class="row"><span>Ending capital</span><b>$'+result.endingCapital.toFixed(2)+'</b></div><div class="row"><span>Profit factor</span><b>'+(result.profitFactor||0).toFixed(2)+'</b></div><div class="row"><span>Max drawdown</span><b>'+result.maxDrawdown.toFixed(2)+'%</b></div><div class="row"><span>Sharpe</span><b>'+result.sharpe.toFixed(2)+'</b></div><div class="row"><span>Average hold</span><b>'+result.averageHold.toFixed(1)+' bars</b></div><div class="row"><span>Best / worst</span><b>'+result.best.toFixed(2)+'% / '+result.worst.toFixed(2)+'%</b></div></div>'+
   '<div class="box"><h3>TEST CONFIGURATION</h3><div class="row"><span>Strategy</span><b>'+result.strategy+'</b></div><div class="row"><span>Asset</span><b>'+asset+'</b></div><div class="row"><span>Timeframe</span><b>'+tf+'</b></div><div class="row"><span>Starting capital</span><b>$'+cfg.capital.toFixed(2)+'</b></div><div class="row"><span>MA fast / slow</span><b>'+cfg.fast+' / '+cfg.slow+'</b></div><div class="row"><span>Spread / slippage / fees</span><b>'+cfg.spread+' / '+cfg.slippage+' / '+cfg.fees+' bps / side</b></div><div class="row"><span>Round-trip cost</span><b>'+result.costPct.toFixed(3)+'%</b></div><div class="row"><span>Exit model</span><b>'+exit+'</b></div><div class="row"><span>Universe coverage</span><b>108 historical assets</b></div><div class="row"><span>Data source</span><b>Committed MTE historical cache</b></div></div>'+extra;mteEnsureCollapsible(results);
  const rows=result.tradeList.map((t,i)=>'<tr><td>'+(i+1)+'</td><td>'+t.entryDate+'</td><td>'+t.exitDate+'</td><td>'+t.direction+'</td><td>$'+Number(t.entryPrice).toFixed(2)+'</td><td>$'+Number(t.exitPrice).toFixed(2)+'</td><td class="'+(t.ret>=0?'good':'warn')+'">'+(t.ret>=0?'+':'')+t.ret.toFixed(2)+'%</td><td>'+t.reason+'</td></tr>').join('');
  tradesPanel.innerHTML='<div class="box" style="margin-top:15px"><h3>INDIVIDUAL TRADE OUTCOMES</h3><div style="overflow:auto"><table><thead><tr><th>#</th><th>ENTRY</th><th>EXIT</th><th>SIDE</th><th>ENTRY PX</th><th>EXIT PX</th><th>NET RETURN</th><th>EXIT REASON</th></tr></thead><tbody>'+rows+'</tbody></table></div></div>';mteEnsureCollapsible(tradesPanel);
  document.getElementById('btExplanation').textContent='REAL HISTORICAL RUN · '+result.strategy+' · '+asset+'. Custom dates, capital, execution costs, timeframe, exit model and Technical 01 train/OOS optimisation are applied to the committed MTE historical cache.';
  backtestCache[strategy+'|'+asset+'|'+exit+'|'+cfg.start+'|'+cfg.end]=result;backtestHistory.push(result);if(backtestHistory.length>20)backtestHistory.shift();renderBacktestHistory();
 }catch(e){if(window.__mteBacktestRunId===runId){status.textContent='ERROR';results.innerHTML='<div class="box"><h3>BACKTEST FAILED</h3><div class="sub">'+e.message+'</div></div>';mteEnsureCollapsible(results);document.getElementById('btExplanation').textContent='BACKTEST FAILED · '+e.message;}}
 finally{if(runButton){runButton.disabled=false;runButton.textContent='RUN BACKTEST';}}
}
function readOptimiserFilters(){
 const num=(id,fallback)=>{const n=Number(document.getElementById(id)?.value);return Number.isFinite(n)?n:fallback;};
 const checked=cls=>Array.from(document.querySelectorAll(cls+':checked')).map(x=>x.value);
 let fastMin=Math.max(2,Math.min(100,Math.floor(num('optFastMin',2)))),fastMax=Math.max(2,Math.min(100,Math.floor(num('optFastMax',20))));
 let slowMin=Math.max(3,Math.min(250,Math.floor(num('optSlowMin',10)))),slowMax=Math.max(3,Math.min(250,Math.floor(num('optSlowMax',100))));
 if(fastMax<fastMin)[fastMin,fastMax]=[fastMax,fastMin];
 if(slowMax<slowMin)[slowMin,slowMax]=[slowMax,slowMin];
 return {
  fastMin,fastMax,fastStep:Math.max(1,Math.floor(num('optFastStep',1))),
  slowMin,slowMax,slowStep:Math.max(1,Math.floor(num('optSlowStep',10))),
  minTrades:Math.max(0,Math.floor(num('optMinTrades',20))),
  minReturn:num('optMinReturn',0),
  minPF:Math.max(0,num('optMinPF',0)),
  minSharpe:num('optMinSharpe',0),
  maxDD:Math.max(0,num('optMaxDD',100)),
  maxScenarios:Math.max(10,Math.floor(num('optMaxScenarios',3000))),
  rankBy:document.getElementById('optRankBy')?.value||'totalReturn',
  timeframes:checked('.opt-timeframe'),
  exits:checked('.opt-exit')
 };
}
async function optimiseTechnicalMatrix(closes,dates,cfg,filters){
 const passing=[];
 let tested=0,passingCount=0,pairCount=0;
 const timeframes=filters.timeframes.length?filters.timeframes:['4H context · 1H management · 15M execution'];
 const exits=filters.exits.length?filters.exits:['STRUCTURE_1H'];
 const prefix=new Array(closes.length+1).fill(0);
 for(let i=0;i<closes.length;i++)prefix[i+1]=prefix[i]+closes[i];
 const runFast=async(fast,slow)=>{
  const trades=[];let prev=null,entryIndex=-1,entryPrice=0;
  for(let i=slow;i<closes.length;i++){
   const fastM=(prefix[i]-prefix[i-fast])/fast,slowM=(prefix[i]-prefix[i-slow])/slow;
   const dir=fastM>slowM?'LONG':'SHORT';
   if(prev===null){prev=dir;entryIndex=i;entryPrice=closes[i];continue;}
   if(dir!==prev){
    const gross=prev==='LONG'?pctJS(closes[i],entryPrice):pctJS(entryPrice,closes[i]),ret=gross-btCostPct(cfg);
    trades.push({direction:prev,ret,bars:i-entryIndex,reason:'TREND_FLIP',entryDate:dates[entryIndex],exitDate:dates[i],entryPrice,exitPrice:closes[i]});
    prev=dir;entryIndex=i;entryPrice=closes[i];
   }
  }
  if(prev&&entryIndex>=0){
   const last=closes.length-1,gross=prev==='LONG'?pctJS(closes[last],entryPrice):pctJS(entryPrice,closes[last]),ret=gross-btCostPct(cfg);
   trades.push({direction:prev,ret,bars:last-entryIndex,reason:'OPEN_AT_END',entryDate:dates[entryIndex],exitDate:dates[last],entryPrice,exitPrice:closes[last]});
  }
  return summariseTrades('',trades,closes.length,'TECHNICAL 01 · Strategy 002',cfg,dates);
 };
 for(let fast=filters.fastMin;fast<=filters.fastMax;fast+=filters.fastStep){
  for(let slow=filters.slowMin;slow<=filters.slowMax;slow+=filters.slowStep){
   if(fast>=slow)continue;
   pairCount++;
   const r=await runFast(fast,slow);
   if(!r)continue;
   let passes=r.trades>=filters.minTrades&&r.totalReturn>=filters.minReturn&&r.profitFactor>=filters.minPF&&r.sharpe>=filters.minSharpe&&r.maxDrawdown<=filters.maxDD;
   for(const timeframe of timeframes){
    for(const exit of exits){
     tested++;
     if(passes){
      passingCount++;
      passing.push({fast,slow,timeframe,exit,result:r});
     }
    }
   }
   if(pairCount%100===0)await new Promise(resolve=>setTimeout(resolve,0));
  }
 }
 const metric=filters.rankBy;
 passing.sort((a,b)=>{
  const av=metric==='maxDrawdown'?a.result.maxDrawdown:a.result[metric],bv=metric==='maxDrawdown'?b.result.maxDrawdown:b.result[metric];
  return metric==='maxDrawdown'?av-bv:bv-av;
 });
 return {scenarios:passing,tested,passingCount,pairCount,filters};
}
async function optimiseBacktest(){return runStrategyLab();}
async function runStrategyLab(){const el=document.getElementById('labStage');if(el&&el.value==='robust'){return runStrategyDiscovery()}return runStrategyDiscovery();}
function setBTDates(){
 const el=document.getElementById('btAsset'); if(!el||!document.getElementById('btStart'))return;
 fetchYahooHistory(el.value).then(rows=>{if(!rows.length)return;const first=rows[0].date,last=rows[rows.length-1].date;const s=document.getElementById('btStart'),e=document.getElementById('btEnd');s.min=first;s.max=last;e.min=first;e.max=last;if(!s.value)s.value=first;if(!e.value)e.value=last;});
}
function selectNextAsset(){const el=document.getElementById('btAsset');el.selectedIndex=(el.selectedIndex+1)%el.options.length;setBTDates();runBacktest()}
document.getElementById('btStrategy').addEventListener('change',()=>{document.getElementById('backtestStatus').textContent='READY';});
document.getElementById('btAsset').addEventListener('change',()=>{document.getElementById('backtestStatus').textContent='READY';setBTDates();});
setBTDates();
</script>
</body>
</html>
<script>renderStrategy('macro');</script>