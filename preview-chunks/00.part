<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>MTE Engine Preview</title>
<style>
*{box-sizing:border-box}body{margin:0;background:#f4f6f8;color:#18212b;font-family:Inter,Arial,Helvetica,sans-serif}
button{font:inherit;cursor:pointer}.app{min-height:100vh}
header{height:72px;background:#fff;border-bottom:1px solid #dce1e6;display:flex;align-items:center;justify-content:space-between;padding:0 30px;position:sticky;top:0;z-index:10}
.brand{display:flex;gap:11px;align-items:center}.brand b{font-size:23px;letter-spacing:-.5px}.brand span{color:#6d7782;font-size:13px}
.switch button{background:#fff;border:1px solid #d7dde3;color:#68737e;padding:8px 13px;margin-left:5px;border-radius:4px;font-size:12px}.switch .active{background:#18212b;color:#fff;border-color:#18212b}
.status{font-size:11px;color:#66717c}.status i{display:inline-block;width:7px;height:7px;border-radius:50%;background:#19a974;margin-right:7px}
main{max-width:1480px;margin:auto;padding:30px}.head{display:flex;justify-content:space-between;gap:30px}
.eyebrow{color:#77828d;font-size:11px;font-weight:700;letter-spacing:.08em}.title{font-size:32px;font-weight:650;margin:7px 0}.sub{color:#6c7782;font-size:13px;line-height:1.5}
.metrics{display:flex;gap:28px}.metric{min-width:95px}.metric small,.metric span{display:block;color:#7b858f;font-size:10px}.metric strong{display:block;font-size:20px;margin:5px 0;color:#18212b}
.nav{margin-top:28px;border-bottom:1px solid #cfd6dd;display:flex;gap:4px;align-items:center}.nav button{background:none;border:1px solid transparent;color:#65717d;padding:9px 14px;font-size:12px;font-weight:650;border-radius:4px}.nav button:hover{background:#eef1f3;color:#18212b}.nav .active{background:#18212b;color:#fff;border-color:#18212b}
.view{display:none}.view.active{display:block}.panel{margin-top:25px}.correlation-mode header .switch{display:none}.correlation-mode .head{display:none}.correlation-mode .strategyMetrics{display:none}.correlation-mode .nav{margin-top:0}.panelhead{display:flex;justify-content:space-between;align-items:end;margin-bottom:16px}.panelhead h2{font-size:17px;margin:0 0 4px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.card{border:1px solid #d7dde3;background:#fff;border-radius:5px;padding:20px;box-shadow:0 1px 2px rgba(20,30,40,.04)}
.top{display:flex;justify-content:space-between}.id{font-size:10px;color:#87919b}.sym{font-size:25px;font-weight:700;margin:6px 0 2px}.pill{padding:5px 9px;border:1px solid #1aa46e;color:#15875b;background:#f0faf6;font-size:10px;font-weight:700;height:max-content;border-radius:3px}.short{border-color:#d65c5c;color:#b43e3e;background:#fff4f4}
.stats{display:grid;grid-template-columns:1fr 1fr;margin:18px 0 14px;gap:12px}.stats div{border-top:1px solid #e4e8ec;padding-top:9px}.stats small,.stats span{display:block;color:#7b858f;font-size:10px}.stats strong{display:block;font-size:16px;margin:4px 0}
.good{color:#12885c}.warn{color:#a56a00}.muted{color:#7b858f}
.source{border-top:1px solid #e4e8ec;padding-top:12px;color:#75808b;font-size:11px}.source b{float:right;color:#2c3640}
.detail-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:15px;margin-top:15px}.box{background:#fff;border:1px solid #d7dde3;border-radius:5px;padding:18px}.box h3{margin:0 0 14px;font-size:13px}.row{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #edf0f2;font-size:11px}.row:last-child{border:0}
.news{font-size:11px;line-height:1.45;padding:10px 0;border-bottom:1px solid #edf0f2}.news b{display:block;color:#27323d;margin-bottom:3px}
.actions{display:flex;gap:8px;margin-top:16px}.actions button{flex:1;padding:10px;background:#fff;color:#34404b;border:1px solid #cdd4db;border-radius:3px;font-size:11px;font-weight:650}.actions .primary{background:#18212b;color:#fff;border-color:#18212b}.actions .danger{color:#a33c3c}
table{width:100%;border-collapse:collapse;background:#fff;border:1px solid #d7dde3;border-radius:5px;overflow:hidden}th,td{text-align:left;padding:12px 14px;border-bottom:1px solid #e6eaed;font-size:11px}th{color:#707b86;font-weight:650;background:#f8f9fa}tr:last-child td{border:0}
.badge{padding:4px 7px;border-radius:3px;background:#edf7f2;color:#167b57;font-size:9px;font-weight:700}.badge.gray{background:#eef1f3;color:#66727d}.badge.amber{background:#fff7e8;color:#956300}
footer{border-top:1px solid #dce1e6;margin-top:45px;padding:16px 30px;color:#7a858f;font-size:10px;display:flex;justify-content:space-between;background:#fff}
.toast{position:fixed;right:25px;bottom:25px;background:#18212b;color:#fff;padding:12px 16px;border-radius:4px;font-size:11px;display:none;z-index:30}.mte-collapse-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:0;margin:0}.mte-open-lab-btn{font-size:11px!important;padding:7px 12px!important;min-width:82px}.mte-lab-run-btn{font-size:11px!important;padding:7px 12px!important}.mte-collapse-head h3{margin:0!important}.mte-collapse-toggle{width:28px;height:28px;padding:0!important;display:inline-flex;align-items:center;justify-content:center;background:#fff;border:1px solid #cdd4db;border-radius:4px;color:#34404b;font-size:16px;line-height:1;font-weight:700;cursor:pointer}.mte-collapse-body{margin-top:12px}.mte-collapse-body.is-collapsed{display:none}.mte-collapsible-result{display:block!important}.mte-results-grid .box{margin:0}.mte-results-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:15px}.lab-help{font-size:11px;color:#66727d;line-height:1.45}.lab-step{border:1px solid #d7dde3;background:#fff;border-radius:7px;padding:14px}.lab-step-title{font-size:10px;font-weight:900;letter-spacing:.04em;color:#66727d;margin-bottom:9px}.lab-choice{border:1px solid #d7dde3!important;background:#fff!important;border-radius:7px!important;transition:.12s ease}.lab-choice[data-selected='1']{border-color:#18212b!important;box-shadow:0 0 0 1px #18212b;background:#f7f9fb!important}.lab-family-card{position:relative;display:flex!important;align-items:flex-start;gap:9px;padding:10px!important;min-height:72px;cursor:pointer}.lab-family-card:hover{border-color:#aeb8c2!important}.lab-family-card input{margin-top:2px}.lab-family-test{margin-left:auto;padding:5px 8px!important;font-size:9px!important;white-space:nowrap}.lab-run-primary{font-size:12px!important;font-weight:850!important;padding:12px 14px!important;border-radius:6px!important}.lab-history-run{border:1px solid #e1e5e9;border-radius:6px;padding:10px 12px;background:#fff;margin-bottom:7px}.lab-history-meta{font-size:10px;color:#697581}.lab-status-complete{color:#12885c}.lab-status-running{color:#956300}@media(max-width:1050px){.mte-results-grid{grid-template-columns:1fr}}
@media(max-width:1050px){.grid{grid-template-columns:1fr 1fr}.detail-grid{grid-template-columns:1fr}.head{display:block}.metrics{margin-top:22px}}
@media(max-width:700px){.grid{grid-template-columns:1fr}.switch{display:none}main{padding:20px}.metrics{gap:15px;flex-wrap:wrap}}

.backtest-controls{margin-top:15px}.control-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.control-grid label{display:flex;flex-direction:column;gap:6px}.control-grid label span{font-size:9px;color:#707b86;font-weight:700}.control-grid select,.control-grid input{padding:10px 11px;border:1px solid #cdd4db;border-radius:3px;background:#fff;color:#26323d;font-size:11px}.control-grid input{width:100%}.backtest-controls .actions{display:flex;gap:8px}.backtest-controls .actions button{flex:0 0 auto;min-width:130px}@media(max-width:1050px){.control-grid{grid-template-columns:1fr 1fr}}@media(max-width:700px){.control-grid{grid-template-columns:1fr}}
</style>
<!-- GPT preview build trigger -->
</head>
<body>
<div class="app">
<header>
 <div class="brand"><b>MTE</b><span>Macro Trading Engine</span></div>
 <div class="switch">
<button class="active strategy-btn" data-strategy="macro">MACRO 01</button>
<button class="strategy-btn" data-strategy="technical">TECHNICAL 01</button>
<button class="strategy-btn" data-strategy="mactech">MACTECH 01</button>
</div>
 <div class="status"><i></i>LIVE DATA · PAPER ONLY · ENGINE READY</div>
</header>
<main>
 <div class="head">
  <div><div class="eyebrow" id="strategyEyebrow">MACRO 01 · STRATEGY 001</div><div class="title" id="strategyTitle">Macro / Event-Driven Trading</div><div class="sub" id="strategySub">News → macro transmission → historical analogue → cross-asset confirmation → risk → entry timing.</div></div>
  <div class="metrics">
   <div class="metric"><small>Universe</small><strong>108</strong><span>liquid assets</span></div>
   <div class="metric"><small>Qualified</small><strong id="qualifiedCount">3</strong><span>current signals</span></div>
   <div class="metric"><small>Positions</small><strong id="pos">0</strong><span>paper</span></div>
   <div class="metric"><small>Daily risk</small><strong>0.0%</strong><span>of 2% max</span></div>
  </div>
 </div>

 <section id="strategySummary" class="box" style="margin-top:22px">
  <div class="panelhead" style="margin-bottom:0">
    <div><h2 id="strategyPanelTitle">MACRO 01 · Qualified Opportunities</h2><div class="sub" id="strategyPanelSub">Historical probability + expected return + strategy qualification.</div></div>
    <b id="strategyState">ACTIVE</b>
  </div>
  <div class="detail-grid" id="strategyMetrics" style="margin-top:15px"></div>
</section>

<nav class="nav">
  <button class="active" data-view="trades">TRADES</button><button data-view="assets">ASSETS</button><button data-view="positions">POSITIONS</button><button data-view="backtest">BACKTEST</button><button data-view="correlation">CORRELATION</button><button data-view="engine">ENGINE</button><button data-view="events">EVENTS</button>
 </nav>

 <section id="correlation" class="view panel">
  <div id="mteCorrelationMount"></div>
 </section>

 <section id="trades" class="view active panel">
  <div class="panelhead"><div><h2>Qualified Opportunities</h2><div class="sub">Only signals passing historical evidence, current conditions, confirmation, liquidity and risk.</div></div><b>3 / 5 maximum</b></div>
  <div class="grid" id="cards"></div>
  <div class="detail-grid">
   <div class="box"><h3>MACRO TRANSMISSION</h3><div class="row"><span>Current regime</span><b>Risk-on / rates sensitive</b></div><div class="row"><span>Primary driver</span><b>US rates + AI capex</b></div><div class="row"><span>Transmission</span><b>Rates → growth → semis</b></div><div class="row"><span>Regime confidence</span><b>78%</b></div></div>
   <div class="box"><h3>CROSS-ASSET CONFIRMATION</h3><div class="row"><span>QQQ vs SPY</span><b class="good">+ confirmation</b></div><div class="row"><span>NVDA vs SOXX</span><b class="good">+ confirmation</b></div><div class="row"><span>US 10Y</span><b>4.18%</b></div><div class="row"><span>USD index</span><b>103.4</b></div></div>
   <div class="box"><h3>RISK GATES</h3><div class="row"><span>Risk / trade</span><b>1.0%</b></div><div class="row"><span>Max daily loss</span><b>2.0%</b></div><div class="row"><span>Max positions</span><b>5</b></div><div class="row"><span>Kill switch</span><b class="good">ARMED</b></div></div>
  </div>
 </section>

 <section id="assets" class="view panel"><div class="panelhead"><div><h2>Asset Universe</h2><div class="sub">Liquid instruments monitored for macro, technical and cross-asset signals.</div></div><b>107+ assets</b></div>
 <table><thead><tr><th>SYMBOL</th><th>ASSET</th><th>CLASS</th><th>PRICE</th><th>24H</th><th>LIQUIDITY</th><th>STATE</th></tr></thead><tbody>
 <tr><td>NVDA</td><td>NVIDIA</td><td>Equity</td><td>$184.62</td><td class="good">+1.84%</td><td>HIGH</td><td><span class="badge">SIGNAL</span></td></tr>
 <tr><td>SPY</td><td>S&amp;P 500 ETF</td><td>Index ETF</td><td>$668.11</td><td class="good">+0.72%</td><td>HIGH</td><td><span class="badge gray">TRACKING</span></td></tr>
 <tr><td>TLT</td><td>20+ Year Treasury ETF</td><td>Rates</td><td>$86.14</td><td class="good">+0.31%</td><td>HIGH</td><td><span class="badge">SIGNAL</span></td></tr>
 <tr><td>GLD</td><td>Gold ETF</td><td>Commodity</td><td>$389.20</td><td class="good">+0.48%</td><td>HIGH</td><td><span class="badge">SIGNAL</span></td></tr>
 <tr><td>BTC-USD</td><td>Bitcoin</td><td>Crypto</td><td>$113,420</td><td class="warn">-0.42%</td><td>HIGH</td><td><span class="badge gray">TRACKING</span></td></tr>
 </tbody></table></section>

 <section id="positions" class="view panel"><div class="panelhead"><div><h2>Paper Positions</h2><div class="sub">Internal execution ledger. No broker orders.</div></div><button onclick="closeAll()" class="actions" style="flex:none;padding:9px 13px;background:#fff;border:1px solid #cdd4db;border-radius:3px;font-size:11px">CLOSE ALL</button></div>
 <table><thead><tr><th>ID</th><th>SYMBOL</th><th>SIDE</th><th>ENTRY</th><th>RISK</th><th>EXPECTED</th><th>HORIZON</th><th>STATUS</th></tr></thead><tbody id="positionRows"><tr><td colspan="8">No paper positions.</td></tr></tbody></table></section>

 <section id="backtest" class="view panel"><div class="panelhead"><div><h2>Historical Evidence</h2><div class="sub">Run the selected strategy against any asset in the 108-asset live historical universe. Macro 01 and Technical 01 use separate strategy logic.</div></div><b id="backtestStatus">READY</b></div>
 <div class="box backtest-controls">
  <div class="control-grid">
   <label><span>STRATEGY</span><select id="btStrategy"><option value="macro">MACRO 01 · Strategy 001</option><option value="technical">TECHNICAL 01 · Strategy 002</option><option value="mactech">MACTECH · Strategy 003</option></select></label>
   <label><span>ASSET · 108 AVAILABLE</span><select id="btAsset"><option value="QQQ">QQQ — Nasdaq 100 ETF</option><option value="SPY">SPY — S&P 500 ETF</option><option value="IWM">IWM — Russell 2000 ETF</option><option value="DIA">DIA — Dow Jones ETF</option><option value="EEM">EEM — Emerging Markets ETF</option><option value="FXI">FXI — China Large Cap ETF</option><option value="KWEB">KWEB — China Internet ETF</option><option value="SOXX">SOXX — Semiconductors ETF</option><option value="XLF">XLF — Financials ETF</option><option value="XLE">XLE — Energy ETF</option><option value="XLI">XLI — Industrials ETF</option><option value="XLK">XLK — Technology ETF</option><option value="XLV">XLV — Healthcare ETF</option><option value="XLP">XLP — Consumer Staples ETF</option><option value="TLT">TLT — 20+ Year Treasury ETF</option><option value="HYG">HYG — High Yield Bond ETF</option><option value="LQD">LQD — Investment Grade Bond ETF</option><option value="GLD">GLD — Gold ETF</option><option value="SLV">SLV — Silver ETF</option><option value="USO">USO — Oil ETF</option><option value="COPX">COPX — Copper Miners ETF</option><option value="AAPL">AAPL — Apple</option><option value="MSFT">MSFT — Microsoft</option><option value="NVDA">NVDA — Nvidia</option><option value="AMZN">AMZN — Amazon</option><option value="GOOGL">GOOGL — Alphabet</option><option value="META">META — Meta</option><option value="AVGO">AVGO — Broadcom</option><option value="TSM">TSM — TSMC</option><option value="AMD">AMD — AMD</option><option value="INTC">INTC — Intel</option><option value="ORCL">ORCL — Oracle</option><option value="CRM">CRM — Salesforce</option><option value="ADBE">ADBE — Adobe</option><option value="NFLX">NFLX — Netflix</option><option value="TSLA">TSLA — Tesla</option><option value="JPM">JPM — JPMorgan</option><option value="BAC">BAC — Bank of America</option><option value="GS">GS — Goldman Sachs</option><option value="MS">MS</option><option value="C">C — Citigroup</option><option value="XOM">XOM — Exxon Mobil</option><option value="CVX">CVX — Chevron</option><option value="COP">COP — ConocoPhillips</option><option value="CAT">CAT — Caterpillar</option><option value="DE">DE — Deere</option><option value="BA">BA — Boeing</option><option value="GE">GE — GE Aerospace</option><option value="WMT">WMT — Walmart</option><option value="COST">COST — Costco</option><option value="HD">HD — Home Depot</option><option value="MCD">MCD — McDonald's</option><option value="NKE">NKE — Nike</option><option value="V">V — Visa</option><option value="MA">MA — Mastercard</option><option value="UNH">UNH — UnitedHealth</option><option value="JNJ">JNJ — Johnson & Johnson</option><option value="PFE">PFE — Pfizer</option><option value="MRK">MRK — Merck</option><option value="LLY">LLY — Eli Lilly</option><option value="XAU/USD">XAU/USD — Gold Spot</option><option value="XAG/USD">XAG/USD — Silver Spot</option><option value="XG/USD">XG/USD — Copper</option><option value="WTI/USD">WTI/USD — WTI Crude</option><option value="XBR/USD">XBR/USD — Brent Crude</option><option value="EUR/USD">EUR/USD — EUR/USD</option><option value="GBP/USD">GBP/USD — GBP/USD</option><option value="AUD/USD">AUD/USD — AUD/USD</option><option value="NZD/USD">NZD/USD — NZD/USD</option><option value="USD/JPY">USD/JPY — USD/JPY</option><option value="USD/CAD">USD/CAD — USD/CAD</option><option value="USD/CHF">USD/CHF — USD/CHF</option><option value="EUR/JPY">EUR/JPY — EUR/JPY</option><option value="BTC/USD">BTC/USD — Bitcoin</option><option value="ETH/USD">ETH/USD — Ethereum</option><option value="SOL/USD">SOL/USD — Solana</option><option value="XRP/USD">XRP/USD — XRP</option><option value="BNB/USD">BNB/USD — BNB</option><option value="DOGE/USD">DOGE/USD — Dogecoin</option><option value="ADA/USD">ADA/USD — Cardano</option><option value="AVAX/USD">AVAX/USD — Avalanche</option><option value="LINK/USD">LINK/USD — Chainlink</option><option value="MSTR">MSTR — Strategy</option><option value="COIN">COIN — Coinbase</option><option value="HOOD">HOOD — Robinhood</option><option value="PLTR">PLTR — Palantir</option><option value="ARM">ARM — Arm Holdings</option><option value="MU">MU — Micron</option><option value="QCOM">QCOM — Qualcomm</option><option value="ASML">ASML — ASML</option><option value="LRCX">LRCX — Lam Research</option><option value="AMAT">AMAT — Applied Materials</option><option value="FCX">FCX — Freeport-McMoRan</option><option value="RIO">RIO — Rio Tinto</option><option value="BHP">BHP — BHP</option><option value="VALE">VALE — Vale</option><option value="GLEN">GLEN — Glencore</option><option value="RIO.AU">RIO.AU — Rio Tinto Australia</option><option value="CBA.AU">CBA.AU — Commonwealth Bank Australia</option><option value="BHP.AU">BHP.AU — BHP Australia</option><option value="FMG.AU">FMG.AU — Fortescue</option><option value="WBC.AU">WBC.AU — Westpac Australia</option><option value="NAB.AU">NAB.AU — NAB Australia</option><option value="ANZ.AU">ANZ.AU — ANZ Australia</option><option value="CSL.AU">CSL.AU — CSL Australia</option><option value="WES.AU">WES.AU — Wesfarmers Australia</option><option value="TLS.AU">TLS.AU — Telstra Australia</option><option value="VIXY">VIXY — VIX Short-Term Futures ETF</option></select></label>
   <label><span>START DATE</span><input id="btStart" type="date"></label>
   <label><span>END DATE</span><input id="btEnd" type="date"></label>
   <label><span>STARTING CAPITAL (AUD)</span><input id="btCapital" type="number" min="1000" step="1000" value="100000"></label>
   <label><span>FAST MA</span><input id="btFast" type="number" min="2" max="100" value="5"></label>
   <label><span>SLOW MA</span><input id="btSlow" type="number" min="3" max="250" value="20"></label>
   <label><span>SPREAD (BPS / SIDE)</span><input id="btSpread" type="number" min="0" step="0.1" value="5"></label>
   <label><span>SLIPPAGE (BPS / SIDE)</span><input id="btSlippage" type="number" min="0" step="0.1" value="2"></label>
   <label><span>FEES (BPS / SIDE)</span><input id="btFees" type="number" min="0" step="0.1" value="1"></label>
   <label><span>ENTRY / MANAGEMENT</span><select id="btTimeframe"><option>4H context · 1H management · 15M execution</option><option>1H context · 15M management · 5M execution</option></select></label>
   <label><span>EXIT MODEL</span><select id="btExit"><option>STRUCTURE_1H</option><option>FIXED_2R</option><option>ATR_2_5</option><option>ATR_3_0</option><option>HYBRID</option><option>ADAPTIVE</option></select></label>
  </div>
  <div class="actions" style="margin-top:14px"><button class="primary" onclick="runBacktest()">RUN BACKTEST</button><button type="button" class="mte-open-lab-btn" onclick="openStrategyLabPanel()">OPEN LAB</button><button onclick="selectNextAsset()">NEXT ASSET</button></div>
 </div>
 <div class="box" id="technicalOptimiserControls" style="margin-top:15px">
  <div style="display:flex;align-items:center;justify-content:space-between;gap:12px">
    <div><h3 style="margin:0">STRATEGY LAB WORKFLOW</h3><div class="sub">This is the research and optimisation layer for the selected strategy. Technical research discovers supporting price-based components; Expanded MTE research tests the core macro / cross-asset architecture.</div></div>
    <button type="button" onclick="toggleTechnicalOptimiserFilters()" id="technicalOptimiserHeaderToggle" class="mte-collapse-toggle" aria-label="Toggle advanced Strategy Lab settings" title="Toggle advanced settings">⌄</button>
  </div>

  <div style="margin-top:14px;padding:12px;border:1px solid #d9dee5;border-radius:6px;background:#fafbfc">
    <div style="font-size:11px;font-weight:800;margin-bottom:8px">STEP 1 · RESEARCH ENGINE</div>
    <div id="strategyLabPath" style="display:grid;grid-template-columns:1fr 1fr;gap:8px">
      <button type="button" class="primary lab-choice" data-lab-path="technical" onclick="setStrategyLabPath('technical')" style="text-align:left;padding:12px"><b>TECHNICAL STRATEGY LAB</b><br><span class="sub">Price-based signal discovery & optimisation</span></button>
      <button type="button" class="secondary lab-choice" data-lab-path="expanded" onclick="setStrategyLabPath('expanded')" style="text-align:left;padding:12px"><b>EXPANDED MTE LAB</b><br><span class="sub">Core macro / cross-asset research</span></button>
    </div>

    <div style="font-size:11px;font-weight:800;margin:15px 0 8px">STEP 2 · RESEARCH STAGE</div>
    <div id="strategyLabStages" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px">
      <button type="button" data-lab-stage="discovery" onclick="setStrategyLabStage('discovery')" class="lab-choice" style="text-align:left;padding:11px;cursor:pointer"><b>1 · DISCOVER</b><br><span class="sub">Find strategy families</span></button>
      <button type="button" data-lab-stage="deep" onclick="setStrategyLabStage('deep')" class="lab-choice" style="text-align:left;padding:11px;cursor:pointer"><b>2 · OPTIMISE</b><br><span class="sub">Deep-search parameters</span></button>
      <button type="button" data-lab-stage="robust" onclick="setStrategyLabStage('robust')" class="lab-choice" style="text-align:left;padding:11px;cursor:pointer"><b>3 · VALIDATE</b><br><span class="sub">Test OOS robustness</span></button>
    </div>

    <div id="strategyLabRunState" class="lab-help" style="margin-top:10px">Technical Strategy Lab · Stage 1 · Discovery</div>
    <button type="button" id="strategyLabRun" class="primary lab-run-primary" onclick="runCurrentStrategyLabStage()" style="margin-top:10px;width:100%">RUN STAGE 1 · DISCOVERY</button><div class="lab-help" style="margin-top:7px;text-align:center">1. Choose a research engine · 2. Choose a stage · 3. Select signal families · 4. RUN. Use TEST on a family to run that family only.</div>
  </div>

  <div id="technicalLabAdvanced" data-collapsed="0" style="margin-top:12px;display:block">
    <div style="padding:12px;border:1px solid #d9dee5;border-radius:6px;background:#fafbfc;margin-bottom:12px">
      <div style="font-size:12px;font-weight:900">TECHNICAL COMPONENT RESEARCH · MACRO 01</div>
      <div class="sub" style="margin-top:5px;line-height:1.5">Technical research is a supporting research engine for MACRO 01. It discovers price-based signal families that can later be combined with the Macro / Cross-Asset engine. It does not replace Macro 01 and does not independently define a live trading signal.</div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:9px">
        <span style="font-size:10px;font-weight:800;padding:5px 8px;border:1px solid #cfd6de;border-radius:999px;background:#fff">DAILY CLOSE DATA</span>
        <span style="font-size:10px;font-weight:800;padding:5px 8px;border:1px solid #cfd6de;border-radius:999px;background:#fff">NO LOOK-AHEAD</span>
        <span style="font-size:10px;font-weight:800;padding:5px 8px;border:1px solid #cfd6de;border-radius:999px;background:#fff">STAGE 1 → 2 → 3</span>
      </div>
    </div>
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:8px"><div style="font-size:11px;font-weight:900">RESEARCH SETTINGS</div><button type="button" id="technicalOptimiserToggle" class="mte-collapse-toggle" onclick="toggleTechnicalOptimiserFilters()" aria-label="Collapse research settings">⌃</button></div>
    <div class="control-grid">
      <label style="display:none"><span>LAB STAGE</span><select id="labStage"><option value="discovery">STAGE 1 · STRATEGY DISCOVERY</option><option value="deep">STAGE 2 · DEEP OPTIMISATION</option><option value="robust">STAGE 3 · ROBUSTNESS</option></select></label>
      <label><span>MIN TRADES</span><input id="optMinTrades" type="number" min="0" step="1" value="20"></label>
      <label><span>MIN TOTAL RETURN %</span><input id="optMinReturn" type="number" step="0.1" value="0"></label>
      <label><span>MIN PROFIT FACTOR</span><input id="optMinPF" type="number" min="0" step="0.05" value="0"></label>
      <label><span>MIN SHARPE</span><input id="optMinSharpe" type="number" step="0.1" value="0"></label>
      <label><span>MAX DRAWDOWN %</span><input id="optMaxDD" type="number" min="0" max="100" step="0.5" value="100"></label>
      <label><span>TOP CANDIDATES</span><input id="labTopN" type="number" min="1" max="50" step="1" value="10"></label>
      <label><span>RANK BY</span><select id="optRankBy"><option value="totalReturn">TOTAL RETURN</option><option value="sharpe">SHARPE</option><option value="profitFactor">PROFIT FACTOR</option><option value="maxDrawdown">LOWEST MAX DRAWDOWN</option><option value="averageReturn">AVERAGE RETURN / TRADE</option></select></label>
    </div>
    <div style="margin-top:12px">
      <div style="display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:7px">
        <span style="font-size:11px;font-weight:900">SIGNAL FAMILIES</span>
        <span style="display:flex;align-items:center;gap:8px"><span id="strategyFamilyCount" class="sub">0 selected</span><button type="button" onclick="runCurrentStrategyLabStage()" class="primary" style="padding:7px 10px;font-size:10px;font-weight:850">RUN SELECTED</button></span>
      </div>
      <div id="strategyFamilyChecks" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px"></div>
    </div>
    <div style="margin-top:12px">
      <span style="font-size:11px;font-weight:700;display:block;margin-bottom:7px">EXIT MODELS</span>
      <label style="display:inline-flex;align-items:center;gap:7px;margin-right:18px;font-size:11px"><input type="checkbox" class="lab-exit" value="STRUCTURE" checked> STRUCTURE</label>
      <label style="display:inline-flex;align-items:center;gap:7px;margin-right:18px;font-size:11px"><input type="checkbox" class="lab-exit" value="FIXED_2R" checked> FIXED 2R</label>
      <label style="display:inline-flex;align-items:center;gap:7px;margin-right:18px;font-size:11px"><input type="checkbox" class="lab-exit" value="ATR_TRAIL" checked> ATR TRAIL</label>
      <label style="display:inline-flex;align-items:center;gap:7px;font-size:11px"><input type="checkbox" class="lab-exit" value="TIME" checked> TIME</label>
    </div>
    <div class="sub" style="margin-top:10px">Research integrity: the committed historical cache is daily close data. Technical research therefore tests daily logic only. Intraday VWAP, volume and execution-time strategies remain unavailable until the required OHLCV cache exists.</div>
  </div>
</div>
<script>
function setStrategyLabPath(path){
 const p=path==='expanded'?'expanded':'technical';
 window.__strategyLabPath=p;
 if(p==='expanded' && typeof window.addExpandedMteLabUI==='function' && !document.getElementById('mteExpandedLab')) window.addExpandedMteLabUI();
 const tech=document.getElementById('technicalLabAdvanced');
 const expanded=document.getElementById('mteExpandedLab');
 if(tech)tech.style.display=p==='technical'?'':'none';
 if(expanded)expanded.style.display=p==='expanded'?'':'none';
 document.querySelectorAll('[data-lab-path]').forEach(b=>{
  const active=b.getAttribute('data-lab-path')===p;
  b.className=(active?'primary':'secondary')+' lab-choice';
  b.setAttribute('aria-pressed',active?'true':'false');
  b.dataset.selected=active?'1':'0';
  b.style.fontWeight='800';
  b.style.borderWidth=active?'2px':'1px';
  b.style.boxShadow=active?'inset 0 0 0 1px rgba(255,255,255,.35)':'none';
  b.style.opacity=active?'1':'0.72';
 });
 const stage=document.getElementById('strategyLabStage')?.value||document.getElementById('labStage')?.value||'discovery';
 setStrategyLabStage(stage,false);
}function setStrategyLabStage(stage,scroll){
 const requested=['discovery','deep','robust'].includes(stage)?stage:'discovery';
 const progress=window.__mteLabProgress||{discovery:0,deep:0,robust:0};
 let s=requested;
 if(s==='deep' && Number(progress.discovery||0)<100)s='discovery';
 if(s==='robust' && Number(progress.deep||0)<100)s=Number(progress.discovery||0)>=100?'deep':'discovery';
 window.__strategyLabStage=s;
 const technical=document.getElementById('labStage'),expanded=document.getElementById('mteLabStage');
 if(technical)technical.value=s;
 if(expanded)expanded.value=s;
 document.querySelectorAll('[data-lab-stage]').forEach(b=>{
  const active=b.getAttribute('data-lab-stage')===s;
  b.style.background=active?'#eef2f6':'#fff';
  b.style.borderColor=active?'#1f2937':'#cfd6de';
 });
 const path=window.__strategyLabPath||'technical';
 const pathLabel=path==='expanded'?'Expanded MTE Lab':'Technical Strategy Lab';
 const stageLabel=s==='discovery'?'Stage 1 · Discovery':s==='deep'?'Stage 2 · Deep Optimisation':'Stage 3 · Robustness & Validation';
 const run=document.getElementById('strategyLabRun');
 if(run)run.textContent='RUN '+stageLabel.toUpperCase();
 const state=document.getElementById('strategyLabRunState');
 if(state)state.textContent=pathLabel+' · '+stageLabel;
 if(scroll){const box=document.getElementById(path==='expanded'?'mteExpandedLab':'optimisationResults');if(box)box.scrollIntoView({behavior:'smooth',block:'start'});}
}
function runCurrentStrategyLabStage(){
 const path=window.__strategyLabPath||'technical';
 const stage=window.__strategyLabStage||'discovery';
 setStrategyLabStage(stage,false);
 if(path==='expanded'){
  if(typeof window.mteExpandedStrategyLab==='function')return window.mteExpandedStrategyLab();
  return;
 }
 if(typeof runStrategyDiscovery==='function')return runStrategyDiscovery();
}
function openStrategyLabPanel(){
 const box=document.getElementById('technicalOptimiserControls');
 if(!box)return;
 box.scrollIntoView({behavior:'smooth',block:'start'});
 box.dataset.collapsed='0';
 const advanced=document.getElementById('technicalLabAdvanced');
 if(advanced)advanced.style.display=(window.__strategyLabPath||'technical')==='technical'?'':'none';
 const btn=document.getElementById('technicalOptimiserToggle'),headerBtn=document.getElementById('technicalOptimiserHeaderToggle');
 [btn,headerBtn].filter(Boolean).forEach(x=>{x.textContent='⌃';x.setAttribute('aria-label','Collapse advanced Strategy Lab settings');});
}
function toggleTechnicalOptimiserFilters(){
 const advanced=document.getElementById('technicalLabAdvanced'),btn=document.getElementById('technicalOptimiserToggle');
 if(!advanced||!btn)return;
 const hidden=advanced.dataset.collapsed==='1';
 advanced.style.display=hidden?'':'none';
 advanced.dataset.collapsed=hidden?'0':'1';
 [btn,headerBtn].filter(Boolean).forEach(x=>{x.textContent=hidden?'⌃':'⌄';x.setAttribute('aria-label',hidden?'Collapse advanced Strategy Lab settings':'Expand advanced Strategy Lab settings');});
}
function initStrategyLabWorkflow(){
 window.__strategyLabPath='technical';
 window.__strategyLabStage='discovery';
 setStrategyLabPath('technical');
 setStrategyLabStage('discovery',false);
 setTimeout(()=>{if(typeof renderLabHistory==='function')renderLabHistory();},0);
}
if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',initStrategyLabWorkflow);else initStrategyLabWorkflow();
</script><div class="detail-grid" id="backtestResults"></div>
 <div class="box" id="backtestHistory" style="margin-top:15px"><div class="mte-collapse-head"><h3>PREVIOUS BACKTESTS</h3><button type="button" class="mte-collapse-toggle" onclick="toggleBacktestHistory()" aria-label="Toggle previous backtests" title="Toggle previous backtests">⌃</button></div><div class="mte-collapse-body" id="backtestHistoryBody">No previous runs in this session.</div></div>
 <div id="btTrades"></div>
 <div class="box" style="margin-top:15px"><h3>STRATEGY / ASSET TESTING</h3><div class="sub" id="btExplanation">Select any asset and strategy above. The paper engine can test the same asset across Macro 01, Technical 01 and MACTECH without changing the asset universe.</div></div>
 </section>

 <section id="engine" class="view panel"><div class="panelhead"><div><h2>Engine Control</h2><div class="sub">Event-driven runtime, data sources, scoring and execution controls.</div></div><b class="good">READY</b></div>
 <table><thead><tr><th>COMPONENT</th><th>IMPLEMENTATION</th><th>STATUS</th><th>ACTION</th></tr></thead><tbody>
 <tr><td>Market data</td><td>Yahoo Finance</td><td><span class="badge">CONNECTED</span></td><td><button onclick="toast('Yahoo market-data refresh requested')">REFRESH</button></td></tr>
 <tr><td>News</td><td>GDELT</td><td><span class="badge">CONNECTED</span></td><td><button onclick="toast('GDELT news scan requested')">SCAN</button></td></tr>
 <tr><td>Persistence</td><td>Supabase Free</td><td><span class="badge">CONFIGURED</span></td><td><button onclick="toast('Supabase health check requested')">CHECK</button></td></tr>
 <tr><td>Execution</td><td>Internal paper</td><td><span class="badge">ACTIVE</span></td><td><button onclick="toast('Paper execution layer active')">TEST</button></td></tr>
 <tr><td>Broker</td><td>None</td><td><span class="badge gray">NOT CONNECTED</span></td><td>—</td></tr>
 </tbody></table></section>

 <section id="events" class="view panel"><div class="panelhead"><div><h2>Event Monitor</h2><div class="sub">News and macro events that can change the opportunity set.</div></div><b>GDELT · LIVE</b></div>
 <div class="grid">
  <div class="box"><h3>MACRO</h3><div class="news"><b>US rates / Fed expectations</b>Rates remain the dominant cross-asset transmission channel.</div><div class="news"><b>US growth expectations</b>Growth-sensitive assets remain responsive to rates moves.</div><div class="news"><b>USD</b>Dollar strength is being used as a confirmation variable.</div></div>
  <div class="box"><h3>COMPANY / SECTOR</h3><div class="news"><b>AI / Semiconductors</b>AI capex and semiconductor leadership remain active signal inputs.</div><div class="news"><b>Technology</b>QQQ / SOXX relative strength is monitored for confirmation.</div><div class="news"><b>Rates-sensitive assets</b>Treasuries and growth equities are monitored jointly.</div></div>
  <div class="box"><h3>ENTRY TIMING</h3><div class="row"><span>Signal state</span><b class="good">QUALIFIED</b></div><div class="row"><span>Entry quality</span><b>WAIT / CONFIRM</b></div><div class="row"><span>Chase protection</span><b>ACTIVE</b></div><div class="row"><span>Next scan</span><b>EVENT-DRIVEN</b></div></div>
 </div></section>
</main>
<footer><span>NO BROKER CONNECTED · INTERNAL PAPER EXECUTION ONLY</span><span>109 ASSETS · STRATEGY 001 · MACRO 01</span></footer>
</div>
<div id="toast" class="toast"></div>

<script>

const strategyData={
 macro:{
  eyebrow:'MACRO 01 · STRATEGY 001',
  title:'Macro / Event-Driven Trading',
  sub:'News → macro transmission → historical analogue → cross-asset confirmation → risk → entry timing.',
  panel:'MACRO 01 · Qualified Opportunities',
  panelSub:'Historical probability + expected return + strategy qualification.',
  count:3,
  metrics:[
   ['Signal source','Macro transmission','Historical analogue','84 comparable cases'],
   ['Primary edge','+3.2% expected','Historical probability','71%'],
   ['Cross-asset','Confirmed','Regime','Risk-on / rates sensitive']
  ]
 },
 technical:{
  eyebrow:'TECHNICAL 01 · STRATEGY 002',
  title:'Technical / Price-Action Trading',
  sub:'Trend → momentum → volatility → volume → technical confirmation → risk → entry timing.',
  panel:'TECHNICAL 01 · Qualified Opportunities',
  panelSub:'Technical setup quality + historical pattern outcome + current market structure.',
  count:2,
  metrics:[
   ['Trend state','BULLISH','Momentum','Positive'],
   ['Primary setup','Breakout / continuation','Historical probability','67%'],
   ['Volatility','Normal','Entry quality','CONFIRM']
  ]
 },
 mactech:{
  eyebrow:'MACTECH · STRATEGY 003',
  title:'Macro + Technical Trading',
  sub:'Macro event/transmission → cross-asset confirmation → trend → momentum → volatility → breakout → position.',
  panel:'MACTECH · Qualified Opportunities',
  panelSub:'Macro context is mandatory; technical confirmation determines whether the market is actually tradable.',
  count:0,
  metrics:[
   ['Macro input','MANDATORY','Technical confirmation','MANDATORY'],
   ['Core signals','Trend + momentum + breakout','Risk filter','Volatility regime'],
   ['Confirmation','Cross-asset','Trade lifecycle','Entry → manage → exit → re-entry']
  ]
 }
};

function renderStrategy(name){
 const s=strategyData[name];
 document.getElementById('strategyEyebrow').textContent=s.eyebrow;
 document.getElementById('strategyTitle').textContent=s.title;
 document.getElementById('strategySub').textContent=s.sub;
 document.getElementById('strategyPanelTitle').textContent=s.panel;
 document.getElementById('strategyPanelSub').textContent=s.panelSub;
 document.getElementById('qualifiedCount').textContent=s.count;
 document.getElementById('strategyState').textContent='ACTIVE';
 document.getElementById('strategyMetrics').innerHTML=s.metrics.map(m=>`
   <div class="box"><div class="row"><span>${m[0]}</span><b>${m[1]}</b></div><div class="row"><span>${m[2]}</span><b>${m[3]}</b></div></div>
 `).join('');
 document.querySelectorAll('.strategy-btn').forEach(b=>b.classList.toggle('active',b.dataset.strategy===name));

 // Update visible opportunity cards for the selected strategy.
 const cards=document.getElementById('cards');
 if(name==='technical'){
  cards.innerHTML=technicalTrades.map((t,i)=>tradeCard(t,i)).join('');
 } else if(name==='mactech'){
  cards.innerHTML=mactechTrades.map((t,i)=>tradeCard(t,i)).join('');
 } else {
  cards.innerHTML=trades.map((t,i)=>tradeCard(t,i)).join('');
 }
 positions=[]; document.getElementById('pos').textContent='0'; renderPositions();
}

const technicalTrades=[
 ['MTE-T-000041','NVDA','NVIDIA','LONG',184.62,67,2.8,'12h',112,84],
 ['MTE-T-000042','SPY','S&P 500 ETF','LONG',668.11,64,1.9,'24h',156,79]
];
const mactechTrades=[];

function tradeCard(t,i){
 return `<div class="card">
 <div class="top"><div><div class="id">${t[0]}</div><div class="sym">${t[1]}</div><div class="sub">${t[2]}</div></div><div class="pill ${t[3]=='SHORT'?'short':''}">${t[3]}</div></div>
 <div class="stats">
  <div><small>Entry</small><strong>$${t[4].toFixed(2)}</strong></div>
  <div><small>Historical probability</small><strong>${t[5]}%</strong><span>sample n=${t[8]}</span></div>
  <div><small>Expected return</small><strong class="good">+${t[6]}%</strong><span>${t[7]} horizon</span></div>
  <div><small>Qualification</small><strong>${t[9]}/100</strong></div>
 </div>
 <div class="source">Strategy Source <b>${document.querySelector('.strategy-btn.active')?.textContent || 'STRATEGY'}</b></div>
 <div class="actions"><button onclick="showDetailsData(${JSON.stringify(t).replace(/"/g,'&quot;')})">DETAILS</button><button class="primary" onclick="openDynamicPaper(${JSON.stringify(t).replace(/"/g,'&quot;')},this)">PAPER TRADE ${t[3]}</button></div>
 </div>`;
}
function showDetailsData(t){toast(`${t[1]} ${t[3]} · ${t[5]}% historical probability · +${t[6]}% expected · ${t[7]}`)}
function openDynamicPaper(t,btn){
 if(positions.some(x=>x[0]===t[0])) return;
 positions.push(t);document.getElementById('pos').textContent=positions.length;
 btn.textContent='PAPER OPENED';btn.disabled=true;renderPositions();toast(`${t[1]} paper position opened`);
}
document.querySelectorAll('.strategy-btn').forEach(b=>b.addEventListener('click',()=>renderStrategy(b.dataset.strategy)));

const trades=[
 ['MTE-000184','NVDA','NVIDIA','LONG',184.62,71,3.2,'24h',84,82],
 ['MTE-000185','TLT','20+ Year Treasury ETF','SHORT',86.14,68,2.1,'48h',61,77],
 ['MTE-000186','GLD','Gold ETF','LONG',389.20,66,1.7,'24h',53,74]
];
let positions=[];
document.getElementById('cards').innerHTML=trades.map((t,i)=>`
<div class="card">
 <div class="top"><div><div class="id">${t[0]}</div><div class="sym">${t[1]}</div><div class="sub">${t[2]}</div></div><div class="pill ${t[3]=='SHORT'?'short':''}">${t[3]}</div></div>
 <div class="stats">
  <div><small>Entry</small><strong>$${t[4].toFixed(2)}</strong></div>
  <div><small>Historical probability</small><strong>${t[5]}%</strong><span>sample n=${t[8]}</span></div>
  <div><small>Expected return</small><strong class="good">+${t[6]}%</strong><span>${t[7]} horizon</span></div>
  <div><small>Qualification</small><strong>${t[9]}/100</strong></div>
 </div>
 <div class="source">Strategy Source <b>MACRO 01 · v001</b></div>
 <div class="actions">
  <button onclick="showDetails(${i})">DETAILS</button>
  <button class="primary" id="trade-${i}" onclick="openPaper(${i})">PAPER TRADE ${t[3]}</button>
 </div>
</div>`).join('');

function showDetails(i){const t=trades[i];toast(`${t[1]} ${t[3]} · ${t[5]}% historical probability · +${t[6]}% expected · ${t[7]}`)}
function openPaper(i){
 const t=trades[i]; if(positions.some(x=>x[0]===t[0])) return;
 positions.push(t);document.getElementById('pos').textContent=positions.length;
 document.getElementById('trade-'+i).textContent='PAPER OPENED';document.getElementById('trade-'+i).disabled=true;
 renderPositions();toast(`${t[1]} paper position opened`);
}
function renderPositions(){
 const el=document.getElementById('positionRows');
 el.innerHTML=positions.length?positions.map(t=>`<tr><td>${t[0]}</td><td>${t[1]}</td><td>${t[3]}</td><td>$${t[4].toFixed(2)}</td><td>1%</td><td>+${t[6]}%</td><td>${t[7]}</td><td><span class="badge">OPEN</span></td></tr>`).join(''):'<tr><td colspan="8">No paper positions.</td></tr>';
}
function closeAll(){positions=[];document.getElementById('pos').textContent='0';renderPositions();trades.forEach((_,i)=>{const b=document.getElementById('trade-'+i);b.disabled=false;b.textContent='PAPER TRADE '+trades[i][3]});toast('All paper positions closed')}
function toast(msg){const t=document.getElementById('toast');t.textContent=msg;t.style.display='block';clearTimeout(window.__toast);window.__toast=setTimeout(()=>t.style.display='none',2200)}
document.querySelectorAll('.nav button').forEach(b=>b.onclick=()=>{
 document.querySelectorAll('.nav button').forEach(x=>x.classList.remove('active'));b.classList.add('active');
 document.querySelectorAll('.view').forEach(x=>x.classList.remove('active'));document.getElementById(b.dataset.view).classList.add('active');
 document.body.classList.toggle('correlation-mode',b.dataset.view==='correlation');
});

const backtestUniverse=["QQQ", "SPY", "IWM", "DIA", "EEM", "FXI", "KWEB", "SOXX", "XLF", "XLE", "XLI", "XLK", "XLV", "XLP", "TLT", "HYG", "LQD", "GLD", "SLV", "USO", "COPX", "AAPL", "MSFT", "NVDA", "AMZN", "GOOGL", "META", "AVGO", "TSM", "AMD", "INTC", "ORCL", "CRM", "ADBE", "NFLX", "TSLA", "JPM", "BAC", "GS", "MS", "C", "XOM", "CVX", "COP", "CAT", "DE", "BA", "GE", "WMT", "COST", "HD", "MCD", "NKE", "V", "MA", "UNH", "JNJ", "PFE", "MRK", "LLY", "XAU/USD", "XAG/USD", "XG/USD", "WTI/USD", "XBR/USD", "EUR/USD", "GBP/USD", "AUD/USD", "NZD/USD", "USD/JPY", "USD/CNH", "USD/CAD", "USD/CHF", "EUR/JPY", "BTC/USD", "ETH/USD", "SOL/USD", "XRP/USD", "BNB/USD", "DOGE/USD", "ADA/USD", "AVAX/USD", "LINK/USD", "MSTR", "COIN", "HOOD", "PLTR", "ARM", "MU", "QCOM", "ASML", "LRCX", "AMAT", "FCX", "RIO", "BHP", "VALE", "GLEN", "RIO.AU", "CBA.AU", "BHP.AU", "FMG.AU", "WBC.AU", "NAB.AU", "ANZ.AU", "CSL.AU", "WES.AU", "TLS.AU", "VIXY"];
const backtestCache={};
const yahooMap={
 "XAU/USD":"GC=F","XAG/USD":"SI=F","XG/USD":"HG=F","WTI/USD":"CL=F","XBR/USD":"BZ=F",
 "EUR/USD":"EURUSD=X","GBP/USD":"GBPUSD=X","AUD/USD":"AUDUSD=X","NZD/USD":"NZDUSD=X","USD/JPY":"JPY=X","USD/CNH":"CNH=X","USD/CAD":"CAD=X","USD/CHF":"CHF=X","EUR/JPY":"EURJPY=X"
};
function yahooTicker(symbol){
 if(symbol.endsWith('.AU')) return symbol.replace('.AU','.AX');
 if(yahooMap[symbol]) return yahooMap[symbol];
 if(symbol.includes('/')) return symbol.replace('/','-');
